---
interface Props {
  post: string;
}
const { post } = Astro.props;
---

<section class="cmts" data-post={post}>
  <h2 class="cmts__heading">Comments</h2>

  <div class="cmts__list" aria-live="polite">
    <p class="cmts__loading">Loading…</p>
  </div>

  <form class="cmts__form" novalidate>
    <div class="cmts__inputs">
      <input
        class="cmts__field"
        name="name"
        type="text"
        placeholder="Your name"
        maxlength="60"
        required
        autocomplete="name"
      />
      <!-- honeypot — hidden from humans -->
      <input name="website" type="text" tabindex="-1" autocomplete="off" aria-hidden="true" />
      <textarea
        class="cmts__field cmts__area"
        name="message"
        placeholder="Leave a comment…"
        maxlength="1000"
        required
        rows="4"
      ></textarea>
    </div>
    <div class="cmts__row">
      <span class="cmts__status" role="status" aria-live="polite"></span>
      <button class="cmts__btn" type="submit">Post comment</button>
    </div>
  </form>
</section>

<script>
  interface Comment { name: string; message: string; date: string; }

  function esc(s: string): string {
    return s
      .replace(/&/g,  '&amp;')
      .replace(/</g,  '&lt;')
      .replace(/>/g,  '&gt;')
      .replace(/"/g,  '&quot;')
      .replace(/'/g,  '&#39;');
  }

  function init() {
    const section   = document.querySelector<HTMLElement>('.cmts[data-post]');
    if (!section) return;

    const post      = section.dataset.post!;
    const listEl    = section.querySelector<HTMLElement>('.cmts__list')!;
    const form      = section.querySelector<HTMLFormElement>('.cmts__form')!;
    const statusEl  = section.querySelector<HTMLElement>('.cmts__status')!;
    const submitBtn = section.querySelector<HTMLButtonElement>('.cmts__btn')!;

    async function load() {
      try {
        const res  = await fetch('/api/comments?post=' + encodeURIComponent(post));
        if (!res.ok) throw new Error();
        const { comments } = await res.json() as { comments: Comment[] };

        if (!comments.length) {
          listEl.innerHTML = '<p class="cmts__empty">No comments yet. Be the first.</p>';
        } else {
          listEl.innerHTML = comments.map(c => {
            const d = new Date(c.date).toLocaleDateString('en-US', {
              year: 'numeric', month: 'short', day: 'numeric',
            });
            return (
              `<article class="cmt">` +
                `<div class="cmt__meta">` +
                  `<span class="cmt__name">${esc(c.name)}</span>` +
                  `<time class="cmt__date">${d}</time>` +
                `</div>` +
                `<p class="cmt__body">${esc(c.message)}</p>` +
              `</article>`
            );
          }).join('');
        }
      } catch {
        listEl.innerHTML = '<p class="cmts__error">Could not load comments.</p>';
      }
    }

    form.addEventListener('submit', async e => {
      e.preventDefault();
      const name    = (form.elements.namedItem('name')    as HTMLInputElement).value.trim();
      const message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();
      const website = (form.elements.namedItem('website') as HTMLInputElement).value;

      if (!name || !message) {
        statusEl.textContent = 'Name and message are required.';
        return;
      }

      submitBtn.disabled   = true;
      statusEl.textContent = 'Posting…';

      try {
        const res = await fetch('/api/comments', {
          method:  'POST',
          headers: { 'Content-Type': 'application/json' },
          body:    JSON.stringify({ post, name, message, website }),
        });
        const data = await res.json() as { ok?: boolean; error?: string };
        if (res.ok) {
          form.reset();
          statusEl.textContent = 'Comment posted!';
          await load();
          setTimeout(() => { statusEl.textContent = ''; }, 3000);
        } else {
          statusEl.textContent = data.error ?? 'Failed to post. Try again.';
        }
      } catch {
        statusEl.textContent = 'Network error. Try again.';
      } finally {
        submitBtn.disabled = false;
      }
    });

    load();
  }

  // Run on initial load and after each View Transition navigation
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .cmts {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
  .cmts__heading {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    margin-bottom: 1.5rem;
  }
  .cmts__list {
    margin-bottom: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cmts__loading, .cmts__empty, .cmts__error {
    font-size: 0.9rem;
    color: var(--color-muted);
  }

  /* Individual comment */
  .cmt {
    padding: 1rem 1.25rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }
  .cmt__meta {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    margin-bottom: 0.5rem;
  }
  .cmt__name {
    font-size: 0.875rem;
    font-weight: 600;
  }
  .cmt__date {
    font-size: 0.775rem;
    color: var(--color-muted);
  }
  .cmt__body {
    font-size: 0.9rem;
    line-height: 1.65;
    white-space: pre-wrap;
    word-break: break-word;
    margin: 0;
  }

  /* Form */
  .cmts__inputs {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    margin-bottom: 0.65rem;
  }
  [name="website"] { display: none; }
  .cmts__field {
    width: 100%;
    padding: 0.575rem 0.85rem;
    font-size: 0.9rem;
    font-family: inherit;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    outline: none;
    box-sizing: border-box;
    transition: border-color 0.15s;
  }
  .cmts__field::placeholder { color: var(--color-muted); opacity: 1; }
  .cmts__field:focus { border-color: var(--color-accent); }
  .cmts__area {
    resize: vertical;
    min-height: 96px;
  }
  .cmts__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .cmts__status {
    font-size: 0.825rem;
    color: var(--color-muted);
    flex: 1;
  }
  .cmts__btn {
    flex-shrink: 0;
    padding: 0.475rem 1rem;
    font-size: 0.85rem;
    font-family: inherit;
    font-weight: 500;
    color: var(--color-text);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    cursor: pointer;
    white-space: nowrap;
    transition: border-color 0.15s, color 0.15s;
  }
  .cmts__btn:hover:not(:disabled) {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }
  .cmts__btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
</style>
