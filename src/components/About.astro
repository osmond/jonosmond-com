---
import { getCollection } from 'astro:content';

const focus = [
  'Accessibility',
  'Product UI',
  'Design systems',
  'Front-end development',
];

const principles = [
  {
    number: '01',
    title: 'Clear by default',
    description: 'Hierarchy and language should do more work than instructions.',
  },
  {
    number: '02',
    title: 'Felt, not announced',
    description: 'Motion and feedback should explain what changed without demanding attention.',
  },
  {
    number: '03',
    title: 'Reliable under pressure',
    description: 'Accessibility and resilient states are part of the product—not cleanup work.',
  },
];

const featuredProjects = [
  {
    name: 'Label Lens',
    href: 'https://github.com/osmond/label-lens',
    demo: 'https://label-lens-beta.vercel.app/',
    description: 'AI-powered ingredient decoder for dietary restrictions and hidden allergens, with personalized safety verdicts.',
    tags: ['Next.js', 'Claude', 'Accessibility'],
  },
  {
    name: 'Protein Explainer',
    href: 'https://github.com/osmond/protein-explainer',
    demo: 'https://protein-explainer-eight.vercel.app/',
    description: '3D protein structure viewer with AI narration to explain complex molecular forms in plain language.',
    tags: ['React', 'Vite', 'NGL Viewer'],
  },
];

const recentPosts = (await getCollection('writing', e => !e.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 2);
---

<section class="about">
  <div class="about__inner">
    <span class="about__label"><span>01</span> About</span>
    <div class="about__content">
      <header class="about__intro">
        <p class="about__bio">
          I care about the moment a complicated product stops feeling complicated.
        </p>
        <div class="about__intro-grid">
          <p class="about__detail">
            I'm a product-focused interface developer working where design and engineering meet—shaping hierarchy, interaction, accessibility, and the systems underneath them. The best result is clear enough to disappear and distinctive enough to remember.
          </p>
          <aside class="about__side-quest">
            <span>Current side quest</span>
            <strong>Two FIATs. Same shape. Opposite briefs.</strong>
            <a href="/writing/same-shape-opposite-briefs">Read the field notes <span aria-hidden="true">→</span></a>
          </aside>
        </div>
      </header>

      <div class="about__principles" aria-label="Design principles">
        {principles.map((principle) => (
          <article class="about__principle">
            <span class="about__principle-number">{principle.number}</span>
            <h3>{principle.title}</h3>
            <p>{principle.description}</p>
          </article>
        ))}
      </div>

      <ul class="about__focus" aria-label="Focus areas">
        {focus.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <h3 class="about__subheading"><span>Selected</span> Work</h3>
      <div class="project-cards" aria-label="Featured projects">
        {featuredProjects.map((project) => (
          <a
            href={project.demo ?? project.href}
            class="project-card"
            aria-label={project.name}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="project-card__header">
              <span class="project-card__name">{project.name}</span>
              <svg class="project-card__arrow" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <p class="project-card__desc">{project.description}</p>
            <div class="project-card__tags">
              <span>{project.demo ? 'Live Demo' : 'GitHub Repo'}</span>
              {project.tags.map(tag => <span>{tag}</span>)}
            </div>
          </a>
        ))}
      </div>
      <h3 class="about__subheading"><span>From the</span> Notebook</h3>
      <div class="project-cards">
      {recentPosts.map(post => {
        const dateStr = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
        return (
          <a href={`/writing/${post.id}`} class="project-card" aria-label={post.data.title}>
            <div class="project-card__header">
              <span class="project-card__name">{post.data.title}</span>
              <svg class="project-card__arrow" aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </div>
            <p class="project-card__desc">{post.data.description}</p>
            <div class="project-card__tags">
              <span>{dateStr}</span>
              {post.data.tags.slice(0, 2).map(tag => <span>{tag}</span>)}
            </div>
          </a>
        );
      })}
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    padding: clamp(4rem, 8vw, 7rem) clamp(2rem, 6vw, 5rem);
    border-top: 1px solid var(--color-border);
  }

  .about__inner {
    max-width: 72rem;
    width: 100%;
    display: grid;
    grid-template-columns: 8rem 1fr;
    gap: 2rem;
    align-items: start;
  }

  @media (max-width: 600px) {
    .about__inner {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
  }

  .about__label {
    position: sticky;
    top: 2rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
    padding-top: 0.35rem;
  }

  .about__label span {
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
    opacity: 0.55;
  }

  .about__intro {
    padding-bottom: clamp(2rem, 4vw, 3.25rem);
    border-bottom: 1px solid var(--color-border);
  }

  .about__bio {
    font-family: var(--font-display);
    max-width: 18ch;
    font-size: clamp(2rem, 4.8vw, 4rem);
    line-height: 1.03;
    letter-spacing: -0.025em;
    color: var(--color-text);
    margin: 0 0 clamp(1.75rem, 4vw, 3rem);
  }

  .about__intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(15rem, 0.65fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  .about__detail {
    max-width: 43rem;
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: clamp(1rem, 1.7vw, 1.125rem);
    line-height: 1.75;
  }

  .about__side-quest {
    position: relative;
    overflow: hidden;
    padding: 1.1rem 1.15rem;
    border: 1px solid var(--color-border-highlight);
    border-radius: 12px;
    background:
      radial-gradient(circle at 100% 0, rgb(196 107 75 / 0.14), transparent 55%),
      var(--color-surface);
  }

  .about__side-quest > span {
    display: block;
    margin-bottom: 0.45rem;
    color: var(--color-accent);
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .about__side-quest strong {
    display: block;
    margin-bottom: 0.85rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
    line-height: 1.25;
  }

  .about__side-quest a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s, gap 0.2s;
  }

  .about__side-quest a:hover {
    gap: 0.55rem;
    color: var(--color-accent);
  }

  .about__principles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin: 0 0 1.5rem;
  }

  .about__principle {
    padding: 1.5rem 1.25rem 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .about__principle + .about__principle {
    padding-left: 1.25rem;
    border-left: 1px solid var(--color-border);
  }

  .about__principle-number {
    display: block;
    margin-bottom: 1.75rem;
    color: var(--color-accent);
    font-family: var(--font-body);
    font-size: 0.625rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }

  .about__principle h3 {
    margin: 0 0 0.45rem;
    color: var(--color-text);
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 400;
  }

  .about__principle p {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-body);
    font-size: 0.8125rem;
    line-height: 1.55;
  }

  .about__focus {
    list-style: none;
    margin: 0 0 3.5rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .about__focus li {
    font-family: var(--font-body);
    font-size: 0.8125rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    padding: 0.35rem 0.85rem;
  }

  .about__subheading {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 0.85rem;
  }

  .about__subheading span {
    color: var(--color-accent);
  }

  .project-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 0 0 2rem;
  }

  @media (max-width: 800px) {
    .project-cards {
      grid-template-columns: 1fr;
    }
  }

  .project-card {
    position: relative;
    overflow: hidden;
    display: block;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    text-decoration: none;
    transition: border-color 0.2s, background 0.2s, transform 0.2s;
  }

  .project-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 2px;
    background: var(--color-accent);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 0.25s ease;
  }

  .project-card:hover {
    border-color: rgba(196, 107, 75, 0.4);
    background: rgba(196, 107, 75, 0.04);
    transform: translateY(-3px);
  }

  .project-card:hover::before {
    transform: scaleY(1);
  }

  .project-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .project-card__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    color: var(--color-text);
  }

  .project-card__arrow {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--color-muted);
    flex-shrink: 0;
    transition: color 0.2s, transform 0.2s;
  }

  .project-card:hover .project-card__arrow {
    color: var(--color-accent);
    transform: translate(3px, -3px);
  }

  .project-card__desc {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0 0 1rem;
  }

  .project-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .project-card__tags span {
    font-family: var(--font-body);
    font-size: 0.75rem;
    color: var(--color-muted);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    padding: 0.2rem 0.65rem;
  }

  @media (max-width: 800px) {
    .about__intro-grid {
      grid-template-columns: 1fr;
    }

    .about__principles {
      grid-template-columns: 1fr;
    }

    .about__principle,
    .about__principle + .about__principle {
      padding: 1.25rem 0;
      border-left: 0;
    }

    .about__principle-number {
      margin-bottom: 0.65rem;
    }
  }

  @media (max-width: 600px) {
    .about__label {
      position: static;
    }

    .about__bio {
      max-width: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card,
    .project-card::before,
    .about__side-quest a {
      transition: none;
    }
  }
</style>
