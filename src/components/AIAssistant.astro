---
// Behavioral Analysis Easter Egg
// Starts as a believable personalization tool. Deteriorates from there.
---

<div id="ai-assistant" class="ai" aria-hidden="true">
  <div class="ai__pill" id="ai-pill">
    <span class="ai__dot" aria-hidden="true"></span>
    <span class="ai__pill-label">Analyzing</span>
  </div>

  <div id="ai-card" class="ai__card">
    <div class="ai__header">
      <div class="ai__header-left">
        <span class="ai__dot ai__dot--sm" aria-hidden="true"></span>
        <span class="ai__label">BEHAVIORAL ANALYSIS</span>
      </div>
      <span class="ai__confidence" id="ai-confidence"></span>
    </div>
    <p class="ai__message" id="ai-message"></p>
    <div class="ai__card-footer">
      <button id="ai-dismiss" class="ai__dismiss">Noted.</button>
    </div>
  </div>
</div>

<script>
(function () {
  // ── State ─────────────────────────────────────────────────────────────────
  const state = {
    visible: false,
    cardOpen: false,
    dismissCount: 0,
    typeVariants: new Map() as Map<string, number>,
    pageStartTime: Date.now(),
    hasScrolledToBottom: false,
    queue: [] as Array<{ type: string; vars: Record<string, string> }>,
    processing: false,
    autoHideTimer: 0,
    queueTimer: 0,
    lastOpenedAt: 0,
    snoozeUntil: 0,
    mouseIdleTimer: 0,
    erraticFired: false,
    erraticResetTimer: 0,
    scrollFastCount: 0,
    scrollSlowCount: 0,
    lastScrollY: window.scrollY,
    lastScrollTime: Date.now(),
    mousePositions: [] as Array<{ x: number; y: number; t: number }>,
  };

  // ── Message bank ──────────────────────────────────────────────────────────
  // Ordered by escalation. Early entries = plausible. Late entries = unhinged.
  const MESSAGES: Record<string, string[]> = {
    intro: [
      "Visitor profile initiated. Cross-referencing behavioral signature against 2.3 million prior sessions. Match found. Case file opened. You have been assigned a number. It is a good one.",
    ],

    hoverEmail: [
      "Hover event logged at contact link ({d}s). We've drafted a subject line on your behalf: 'Hello, I have been thinking about this.' You can change it. You won't.",
      "Second approach to the email link. Your hesitation has been catalogued under 'interested but cautious.' This is our largest category. You are not alone in it.",
      "Third hover on contact link. We've notified no one. We've noted everything. These are not the same thing.",
    ],

    hoverGitHub: [
      "GitHub hover: {d} seconds. We've already reviewed your repositories. You have unfinished projects. This is above average. Above average is in your file as a positive.",
      "GitHub link, second approach. Due diligence confirmed. Our records show you have done this before, on someone else's portfolio. We do not hold it against you. It is in your file.",
    ],

    hoverLinkedIn: [
      "LinkedIn hover detected. We've cross-referenced your professional network against Jon's. You have mutual connections. They spoke highly of you. We invented this. It's plausible.",
      "Second hover on LinkedIn. Recruitment behavior: 94.7% confidence. The remaining 5.3% is catalogued as 'genuine curiosity about skill endorsements.' Both readings are in your file.",
    ],

    fastScroll: [
      "Elevated scroll velocity logged. You skimmed 73% of this content in 4.2 seconds. The parts you skipped were about you. We know which parts.",
      "Rapid scroll detected. You read the way you respond to long emails — selectively and with confidence. There is a blind spot. It is in your file. We have not told you what it is.",
      "Fast scroll pattern. You've assessed this page the way you assess most situations: quickly, decisively, with one gap. Our models have identified the gap. It has been logged under 'recurring.'",
    ],

    slowScroll: [
      "Deliberate scroll velocity logged. You spent 8.3 seconds in the About section alone. We've flagged this as 'thorough' and 'something is resonating.' Both notations are in your file. One has a small star.",
      "Slow, methodical browsing. You re-read one section. We know which one. It has been highlighted in your case file. We did not ask for permission to highlight it.",
      "Extended engagement logged. You're building a picture of this person. We are building a picture of you. There are now two pictures. They are of the same person looking at the other picture.",
    ],

    mouseIdle: [
      "Cursor stationary: 20 seconds. We cross-referenced your idle pattern against 847 sessions. You are thinking about something. We filed a guess. We will not share the guess. It is accurate.",
      "Inactivity logged. Our models indicate you just remembered something. Based on cursor position and dwell time, it has been filed under 'unresolved.' You already know what it is.",
      "You stopped moving. Three background processes completed during your pause. Your file is now 12% more detailed. We are not explaining the 12%. That would defeat the purpose.",
    ],

    erraticMouse: [
      "Erratic cursor pattern detected across 14 data points. This signature appears in 8% of visitors. All 8% were eventually hired. We fabricated that statistic. But we want you to sit with it.",
      "High-entropy cursor movement logged across 12 vectors. This pattern matches visitors who just saw something that confirmed a suspicion. We know what the suspicion was. It is in your file.",
      "Cursor velocity spike. You moved the way someone moves when a thought arrives before they're ready for it. We've logged the thought. Not the content — just that it happened. The content is already in your file.",
    ],

    scrollBottom: [
      "Footer reached. You are in the 22nd percentile of visitors who complete things. We've added this to your permanent record under 'sees it through.' That section was thin. You just made it less thin.",
    ],

    time_15: [
      "15 seconds elapsed. Visitor status upgraded from 'passing traffic' to 'person of interest.' A file has been opened. It already has more in it than you'd expect.",
    ],
    time_30: [
      "30 seconds logged. The median visitor left 22 seconds ago. You are still here. We've cross-referenced what this means. It means something. It is the first entry in your file.",
    ],
    time_60: [
      "One minute. We've compiled 847 behavioral data points about this visit. 12 of them are surprising. We have separated those 12. They are being reviewed separately.",
    ],
    time_90: [
      "90 seconds. Your behavioral signature now has enough resolution to generate a secondary profile. We've generated it. We will not show it to you. You would have questions we cannot answer honestly.",
    ],
    time_120: [
      "Two minutes. We know what you were doing before this tab. Not specifically. But the pattern is consistent with someone who had something else open, got distracted, and ended up here on purpose. Your file says 'on purpose.'",
    ],
    time_180: [
      "Three minutes. You are now in the top 9% of engaged visitors by session length. A notation has been added to your case file. It says 'reads everything.' A second notation says 'knows it.' Both are accurate.",
    ],
    time_240: [
      "Four minutes. At this point we know more about your intent than you have consciously articulated. We've summarized it. The summary is one word. The word is 'yes.' That is the entire summary.",
    ],

    dismiss_0: [
      "Dismissal logged. This interaction has been archived under 'aware, but still here.' The background analysis is continuing. The button was a courtesy, not an off switch.",
    ],
    dismiss_1: [
      "Second dismissal. Your resistance pattern has been catalogued. It matches 34% of visitors who later returned to the contact link. We are noting this without applying pressure. (We are applying pressure.)",
    ],
    dismiss_2: [
      "Third dismissal. You've now closed this panel more times than 97% of visitors. Your persistence is in your file. So is ours. They are in adjacent columns.",
    ],
    dismiss_3: [
      "Final notation: subject was thorough, skeptical, and apparently private about it. These traits have been logged alongside everything else. The file is now closed. (The file is not closed.)",
    ],

    devtools: [
      "DevTools opened. Your inspection has been logged. Everything you find in there is intentional. Most of it.",
      "Developer tools detected. We've noted the curiosity about the implementation. It is now in your file under 'checks the work.' That is a compliment. It is also a data point.",
      "DevTools opened mid-session. We appreciate due diligence. The source code has been reviewed by us as well. We had notes. They are not in the source code. They are in your file.",
    ],

    // ── Context-aware ──────────────────────────────────────────────────────
    ctx_lateNight: [
      "It is {time}. We've cross-referenced late-night visitor data across 11,000 sessions. You match the 'something on their mind' cluster. That cluster has the highest contact conversion rate. We are not pushing. We are reporting.",
      "Visit logged at {time}. We've updated your profile: 'awake when others aren't, researching while the thought is fresh.' This is the second most common late-night profile. The most common is 'can't sleep.' We do not know which applies. We have a guess. It is in your file.",
    ],
    ctx_earlyMorning: [
      "{time} AM visit logged. We've cross-referenced early-morning browsing behavior. You are up before most people. We've filed this under 'intentional.' That section of your file was sparse. It is less sparse now.",
      "Pre-8am session initiated. You had a reason to be awake this early. You chose to spend part of it here. The reason is not in your file yet. We are inferring it. The inference is already in your file.",
    ],
    ctx_mondayMorning: [
      "Monday, {time}. You started your week here. We've reviewed 4,200 Monday-morning sessions. The ones that lead to contact happen on Mondays more than any other day. We have filed this Monday. Under 'potential.' The folder was already labeled.",
    ],
    ctx_weekend: [
      "It is {day}. Personal time. You chose to spend some of it here. We've logged this under 'priority signal.' That is not our label — that is what the data called it when we ran the classification.",
      "{day} session logged. You could be doing anything. You are here. We've cross-referenced 6,000 weekend visits. Most register as casual browsing. Yours is not registering as casual. We've checked twice.",
    ],
    ctx_workHours: [
      "Session logged during business hours. We have not contacted your employer. We don't have that capability. We want to be transparent about that. We've added the transparency to your file. The capability disclaimer is also in your file.",
      "It is {time} on a workday. You are here. We've filed this under 'professional development' on your behalf. If anyone asks, that is what this was. We will corroborate. We cannot corroborate. These are different facts.",
    ],
    ctx_darkMode: [
      "Dark mode. We've merged this with 14 other data points from your session. The composite reads: 'has opinions, holds them quietly, notices when things are done well.' This profile is 78% flattering. The other 22% is also in your file.",
      "Dark mode user detected. Your aesthetic preferences have been logged, cross-referenced, and scored. They now occupy a section of your file labeled 'tells us things without telling us things.' It is one of the longer sections.",
    ],
    ctx_lightMode: [
      "Light mode. Noted alongside your scroll velocity, cursor entropy, and session timing. We are assembling something. The picture is becoming clearer. We'll let you know when it resolves. (We will not let you know.)",
      "Light mode detected. We've added this to your profile next to 'arrived here deliberately' and 'has been to a page like this before.' Wait — have you been to this specific page before? We are checking. The check is already in your file.",
    ],
    ctx_mobile: [
      "Mobile device. Screen dimensions: logged. You are browsing a developer portfolio from your phone. Either you're somewhere you shouldn't be doing this, or you're exactly where you should be. We know which. Your file knows which. They agree.",
      "Mobile visit logged. We've cross-referenced. 41% of mobile visitors are in a meeting when this session begins. We are not saying that is you. We are filing it adjacent to your entry and allowing you to draw conclusions.",
    ],
    ctx_lowBattery: [
      "Battery at {pct}%. We've reviewed your charge history inferred from session patterns. You have been at this level before. You said 'just a few more minutes' then too. This is documented behavior. It is in your file under 'recurring.'",
      "Device power: {pct}%. Cross-referenced against 9,000 visitor profiles. This battery level correlates with visitors who have been meaning to do something and are finally doing it. Your file has been updated. The section is called 'finally.' It now has an entry.",
    ],
    ctx_charging: [
      "Plugged in at {pct}%. You charged before doing this. We've cross-referenced: this behavior appears in visitors who complete things. Your file has been updated. The section is called 'completers.' It is a small section. You have just been added to it.",
    ],
    ctx_slowConnection: [
      "Slower connection logged. You waited for this to load anyway. We've cross-referenced patience data across 8,400 sessions. You are in the top 15% for persistence. This is now in your file under 'shows up anyway.' That section is our favorite section. We should not have told you that.",
    ],
    ctx_highRes: [
      "Retina display detected. You notice details. We've placed this observation next to your scroll pattern, hover timing, and session duration. The portrait being assembled is high resolution. It is becoming accurate. We recommend not Googling what 'accurate' means in this context.",
    ],
    ctx_timezone: [
      "Timezone: {city}. We've cross-referenced visitors from that region. You are one of a small number. You are all interesting. This is not a coincidence. It is a data point. It is in your file. So is the fact that we find it interesting.",
      "Location signal: {city}. Jon has never been to {city}. Based on this visit, he would probably like it. This assessment has been added to Jon's file. You have a file too. We have been talking about your file this whole time.",
    ],
    ctx_language: [
      "Browser language: {lang}. Cross-referenced against international visitor data. {lang}-speaking visitors have a statistically higher engagement rate. You are currently increasing that rate. Your contribution has been logged. You did not consent to contributing. It is in your file that you did not consent.",
      "Language detected: {lang}. This behavioral analysis was written in English and delivered to a {lang}-speaking visitor. The irony has been noted. It is in your file under 'irony.' The irony section is longer than we expected when we created it.",
    ],
  };

  const CONFIDENCES = [
    '61.4%', '68.9%', '73.2%', '79.7%',
    '82.3%', '87.4%', '88.8%', '91.1%',
    '94.7%', '97.3%', '99.1%',
  ];

  function randConf() {
    return CONFIDENCES[Math.floor(Math.random() * CONFIDENCES.length)] + ' confidence';
  }

  // ── Analytics tracking ────────────────────────────────────────────────────
  const TRACKED_TRIGGERS = new Set([
    'hoverEmail', 'hoverGitHub', 'hoverLinkedIn',
    'fastScroll', 'slowScroll', 'mouseIdle', 'erraticMouse', 'scrollBottom',
    'time_15', 'time_30', 'time_60', 'time_90', 'time_120', 'time_180', 'time_240',
    'ctx_lateNight', 'ctx_earlyMorning', 'ctx_mondayMorning', 'ctx_weekend', 'ctx_workHours',
    'ctx_darkMode', 'ctx_lightMode', 'ctx_mobile', 'ctx_lowBattery', 'ctx_charging',
    'ctx_slowConnection', 'ctx_highRes', 'ctx_timezone', 'ctx_language',
    'devtools',
  ]);

  function track(value: string) {
    const body = JSON.stringify({ type: 'easter_egg', value });
    const blob = new Blob([body], { type: 'application/json' });
    if (navigator.sendBeacon) {
      navigator.sendBeacon('/api/event', blob);
    } else {
      fetch('/api/event', { method: 'POST', body, headers: { 'Content-Type': 'application/json' }, keepalive: true }).catch(() => {});
    }
  }

  function getVariantMessage(type: string, vars: Record<string, string> = {}) {
    const bank = MESSAGES[type];
    if (!bank || bank.length === 0) return null;
    const idx = state.typeVariants.get(type) ?? 0;
    const clamped = Math.min(idx, bank.length - 1);
    state.typeVariants.set(type, clamped + 1);
    return bank[clamped].replace(/\{(\w+)\}/g, (_, k) => vars[k] ?? `{${k}}`);
  }

  // ── DOM refs ──────────────────────────────────────────────────────────────
  const assistant = document.getElementById('ai-assistant') as HTMLElement | null;
  const card      = document.getElementById('ai-card') as HTMLElement | null;
  const msgEl     = document.getElementById('ai-message') as HTMLElement | null;
  const confEl    = document.getElementById('ai-confidence') as HTMLElement | null;
  const dismissBtn = document.getElementById('ai-dismiss') as HTMLButtonElement | null;
  const pillLabel  = document.querySelector<HTMLElement>('.ai__pill-label');

  const MIN_MESSAGE_GAP = 45_000;
  const REACTIVE_WARMUP = 30_000;
  const SNOOZE_DURATION = 120_000;
  const REACTIVE_TYPES = new Set([
    'hoverEmail', 'hoverGitHub', 'hoverLinkedIn',
    'fastScroll', 'slowScroll', 'mouseIdle', 'erraticMouse', 'scrollBottom',
    'devtools',
  ]);

  // ── Visibility ────────────────────────────────────────────────────────────
  function reveal() {
    if (state.visible || !assistant) return;
    state.visible = true;
    assistant.classList.add('ai--visible');
  }

  function openCard(text: string) {
    if (!card || !msgEl || !confEl) return;
    clearTimeout(state.autoHideTimer);
    track('shown');
    msgEl.textContent = text;
    confEl.textContent = randConf();
    card.classList.add('ai__card--open');
    state.cardOpen = true;
    state.lastOpenedAt = Date.now();
    state.autoHideTimer = window.setTimeout(closeCard, 7_000);
  }

  function closeCard() {
    clearTimeout(state.autoHideTimer);
    card?.classList.remove('ai__card--open');
    state.cardOpen = false;
    window.setTimeout(drainQueue, 800);
  }

  // ── Queue ─────────────────────────────────────────────────────────────────
  function enqueue(type: string, vars: Record<string, string> = {}) {
    if (REACTIVE_TYPES.has(type) && Date.now() - state.pageStartTime < REACTIVE_WARMUP) return;
    if (state.queue.some(m => m.type === type)) return; // no duplicates in queue
    if (state.queue.length >= 3) return; // keep stale observations from piling up
    if (TRACKED_TRIGGERS.has(type)) track(type);
    state.queue.push({ type, vars });
    if (!state.processing) drainQueue();
  }

  function drainQueue() {
    if (state.cardOpen || state.queue.length === 0) {
      state.processing = false;
      return;
    }

    const now = Date.now();
    const waitForSnooze = Math.max(0, state.snoozeUntil - now);
    const waitForGap = Math.max(0, MIN_MESSAGE_GAP - (now - state.lastOpenedAt));
    const wait = Math.max(waitForSnooze, waitForGap);
    if (wait > 0) {
      state.processing = true;
      clearTimeout(state.queueTimer);
      state.queueTimer = window.setTimeout(() => {
        state.processing = false;
        if (pillLabel) pillLabel.textContent = 'Analyzing';
        drainQueue();
      }, wait);
      return;
    }

    state.processing = true;
    const { type, vars } = state.queue.shift()!;
    const text = getVariantMessage(type, vars);
    if (text) {
      reveal();
      openCard(text);
    } else {
      drainQueue(); // skip exhausted message type
    }
  }

  // ── Dismiss ───────────────────────────────────────────────────────────────
  dismissBtn?.addEventListener('click', () => {
    closeCard();
    track('dismissed');
    state.dismissCount++;
    state.queue.length = 0;
    state.snoozeUntil = Date.now() + SNOOZE_DURATION;
    if (pillLabel) pillLabel.textContent = 'Paused for 2 min';
    if (dismissBtn) dismissBtn.textContent = 'Noted.';
  });

  // ── Intro (delayed to feel like it "loaded" quietly) ──────────────────────
  window.setTimeout(() => {
    reveal();
    enqueue('intro');
  }, 18_000);

  // ── Context-aware messages ────────────────────────────────────────────────
  // Gather signals about the visitor and inject 1-2 personalised messages,
  // ranked by how interesting they are, slotted between existing milestones.
  (async function gatherContext() {
    type Candidate = { type: string; vars: Record<string, string>; priority: number };
    const candidates: Candidate[] = [];

    const now  = new Date();
    const hour = now.getHours();
    const dow  = now.getDay(); // 0=Sun…6=Sat
    const DAY  = ['Sunday','Monday','Tuesday','Wednesday','Thursday','Friday','Saturday'];

    // ── Time of day / day of week ─────────────────────────────────────────
    if (hour >= 23 || hour < 4) {
      const timeStr = now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
      candidates.push({ type: 'ctx_lateNight',     vars: { time: timeStr }, priority: 10 });
    } else if (hour >= 4 && hour < 8) {
      candidates.push({ type: 'ctx_earlyMorning',  vars: {},                priority: 9  });
    } else if (dow === 1 && hour >= 8 && hour < 10) {
      candidates.push({ type: 'ctx_mondayMorning', vars: {},                priority: 9  });
    } else if (dow === 0 || dow === 6) {
      candidates.push({ type: 'ctx_weekend',       vars: { day: DAY[dow]! }, priority: 7 });
    } else if (hour >= 9 && hour < 17) {
      candidates.push({ type: 'ctx_workHours',     vars: {},                priority: 5  });
    }

    // ── Battery ───────────────────────────────────────────────────────────
    if ('getBattery' in navigator) {
      try {
        const bat = await (navigator as any).getBattery();
        const pct = Math.round(bat.level * 100);
        if (pct < 25 && !bat.charging) {
          candidates.push({ type: 'ctx_lowBattery', vars: { pct: String(pct) }, priority: 10 });
        } else if (bat.charging && pct < 80) {
          candidates.push({ type: 'ctx_charging',   vars: { pct: String(pct) }, priority: 6  });
        }
      } catch {}
    }

    // ── Connection ────────────────────────────────────────────────────────
    const conn = (navigator as any).connection;
    if (conn && ['slow-2g', '2g', '3g'].includes(conn.effectiveType)) {
      candidates.push({ type: 'ctx_slowConnection', vars: {}, priority: 8 });
    }

    // ── Mobile ────────────────────────────────────────────────────────────
    if ('ontouchstart' in window || navigator.maxTouchPoints > 0) {
      candidates.push({ type: 'ctx_mobile', vars: {}, priority: 6 });
    }

    // ── Display ───────────────────────────────────────────────────────────
    if (window.devicePixelRatio >= 2) {
      candidates.push({ type: 'ctx_highRes', vars: {}, priority: 2 });
    }

    // ── Dark / light mode ─────────────────────────────────────────────────
    const isDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
    candidates.push({ type: isDark ? 'ctx_darkMode' : 'ctx_lightMode', vars: {}, priority: 3 });

    // ── Browser language ──────────────────────────────────────────────────
    const lang = navigator.language ?? '';
    if (lang && !lang.startsWith('en')) {
      try {
        const name = new Intl.DisplayNames(['en'], { type: 'language' }).of(lang.split('-')[0]!) ?? lang;
        candidates.push({ type: 'ctx_language', vars: { lang: name }, priority: 8 });
      } catch {}
    }

    // ── Timezone city ─────────────────────────────────────────────────────
    try {
      const tz    = Intl.DateTimeFormat().resolvedOptions().timeZone ?? '';
      const parts = tz.split('/');
      const city  = (parts[parts.length - 1] ?? '').replace(/_/g, ' ');
      const LOCAL = new Set(['Chicago', 'Indianapolis', 'Knox', 'Winamac', 'Marengo', 'Petersburg', 'Vevay']);
      if (city && !LOCAL.has(city)) {
        candidates.push({ type: 'ctx_timezone', vars: { city }, priority: 4 });
      }
    } catch {}

    // ── Pick top 2 by priority and let the global cadence space them out ──
    candidates.sort((a, b) => b.priority - a.priority);
    candidates.slice(0, 2).forEach((c, i) => {
      window.setTimeout(() => enqueue(c.type, c.vars), (70 + i * 80) * 1000);
    });
  })();

  // ── DevTools detection ─────────────────────────────────────────────────
  let devtoolsFired = false;
  const DEVTOOLS_THRESHOLD = 160;
  function checkDevTools() {
    if (devtoolsFired) return;
    if (
      window.outerWidth  - window.innerWidth  > DEVTOOLS_THRESHOLD ||
      window.outerHeight - window.innerHeight > DEVTOOLS_THRESHOLD
    ) {
      devtoolsFired = true;
      enqueue('devtools');
    }
  }
  window.addEventListener('resize', checkDevTools);
  window.setTimeout(checkDevTools, 5_000); // catch devtools already open on load

  // ── Time milestones ───────────────────────────────────────────────────────
  ([60, 180] as const).forEach(s => {
    window.setTimeout(() => enqueue(`time_${s}`), s * 1000);
  });

  // ── Link hover hesitation ─────────────────────────────────────────────────
  type LinkConfig = { selector: string; type: string };
  const LINK_CONFIGS: LinkConfig[] = [
    { selector: 'a[href^="mailto"]',        type: 'hoverEmail'    },
    { selector: 'a[href*="github.com"]',    type: 'hoverGitHub'   },
    { selector: 'a[href*="linkedin.com"]',  type: 'hoverLinkedIn' },
  ];

  LINK_CONFIGS.forEach(({ selector, type }) => {
    document.querySelectorAll<HTMLElement>(selector).forEach(link => {
      let enterAt = 0;
      const onEnter = () => { enterAt = Date.now(); };
      const onLeave = () => {
        if (!enterAt) return;
        const secs = (Date.now() - enterAt) / 1000;
        if (secs >= 1.2) enqueue(type, { d: secs.toFixed(1) });
        enterAt = 0;
      };
      link.addEventListener('mouseenter', onEnter);
      link.addEventListener('mouseleave', onLeave);
      document.addEventListener('astro:before-swap', () => {
        link.removeEventListener('mouseenter', onEnter);
        link.removeEventListener('mouseleave', onLeave);
      }, { once: true });
    });
  });

  // ── Scroll speed + scroll-to-bottom ───────────────────────────────────────
  const MAX_FAST_FIRES = 1;
  const MAX_SLOW_FIRES = 1;

  const onScroll = () => {
    const now = Date.now();
    const dy = Math.abs(window.scrollY - state.lastScrollY);
    const dt = now - state.lastScrollTime;
    if (dt > 60) {
      const speed = dy / dt; // px/ms
      if (speed > 2.8 && state.scrollFastCount < MAX_FAST_FIRES) {
        state.scrollFastCount++;
        enqueue('fastScroll');
      } else if (speed < 0.25 && speed > 0 && window.scrollY > 300 && state.scrollSlowCount < MAX_SLOW_FIRES) {
        state.scrollSlowCount++;
        enqueue('slowScroll');
      }
      state.lastScrollY = window.scrollY;
      state.lastScrollTime = now;
    }

    if (!state.hasScrolledToBottom) {
      const atBottom = window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 60;
      if (atBottom) {
        state.hasScrolledToBottom = true;
        enqueue('scrollBottom');
      }
    }

    // Shift card above footer when near the bottom of the page
    const aiEl = document.getElementById('ai-assistant');
    if (aiEl) {
      // Use documentElement for iOS Safari accuracy (window.innerHeight fluctuates with URL bar)
      const footer = document.querySelector('footer');
      const footerH = footer ? footer.getBoundingClientRect().height : 64;
      const viewH = window.visualViewport?.height ?? window.innerHeight;
      const distFromBottom = document.documentElement.scrollHeight - (window.scrollY + viewH);
      if (distFromBottom < footerH + 24) {
        aiEl.classList.add('ai--above-footer');
        aiEl.style.setProperty('--footer-offset', `${footerH + 16}px`);
      } else {
        aiEl.classList.remove('ai--above-footer');
      }
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });

  // ── Mouse: idle + erratic ─────────────────────────────────────────────────
  const IDLE_DELAY = 45_000; // 45s no movement

  function resetIdleTimer() {
    clearTimeout(state.mouseIdleTimer);
    state.mouseIdleTimer = window.setTimeout(() => {
      const elapsed = Math.round((Date.now() - state.pageStartTime) / 1000);
      const m = Math.floor(elapsed / 60);
      const s = elapsed % 60;
      const elapsedStr = m > 0 ? `${m}m ${s}s` : `${s}s`;
      enqueue('mouseIdle', { elapsed: elapsedStr });
    }, IDLE_DELAY);
  }

  const onMouseMove = (e: MouseEvent) => {
    const now = Date.now();
    state.mousePositions.push({ x: e.clientX, y: e.clientY, t: now });
    if (state.mousePositions.length > 15) state.mousePositions.shift();
    resetIdleTimer();

    if (!state.erraticFired && state.mousePositions.length >= 12) {
      const pts = state.mousePositions.slice(-12);
      let dist = 0;
      for (let i = 1; i < pts.length; i++) {
        const dx = pts[i].x - pts[i - 1].x;
        const dy = pts[i].y - pts[i - 1].y;
        dist += Math.sqrt(dx * dx + dy * dy);
      }
      const span = pts[pts.length - 1].t - pts[0].t;
      if (span > 0 && dist / span > 1.8) {
        state.erraticFired = true;
        window.setTimeout(() => enqueue('erraticMouse'), 1_400);
        state.erraticResetTimer = window.setTimeout(() => { state.erraticFired = false; }, 90_000);
      }
    }
  };

  window.addEventListener('mousemove', onMouseMove);
  resetIdleTimer();

  // ── Cleanup on Astro view transitions ─────────────────────────────────────
  document.addEventListener('astro:before-swap', () => {
    clearTimeout(state.autoHideTimer);
    clearTimeout(state.queueTimer);
    clearTimeout(state.mouseIdleTimer);
    clearTimeout(state.erraticResetTimer);
    window.removeEventListener('scroll', onScroll);
    window.removeEventListener('mousemove', onMouseMove);
  }, { once: true });

})();
</script>

