---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Not Found" description="This page doesn't exist.">
  <main class="nf">
    <canvas id="nf-canvas" aria-hidden="true"></canvas>
    <div class="nf__content">
      <span class="nf__code">404</span>
      <h1 class="nf__heading">Lost in the noise</h1>
      <p class="nf__sub">This page doesn't exist — or it did, once.</p>
      <a href="/" class="nf__home">
        <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M10 3L5 8l5 5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Go home
      </a>
    </div>
  </main>
</Layout>

<script>
(function () {
  const canvas = document.getElementById('nf-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const dpr = Math.min(window.devicePixelRatio || 1, 2);
  const isDark = !window.matchMedia('(prefers-color-scheme: light)').matches;

  function resize() {
    canvas.width  = window.innerWidth  * dpr;
    canvas.height = window.innerHeight * dpr;
    canvas.style.width  = window.innerWidth  + 'px';
    canvas.style.height = window.innerHeight + 'px';
    ctx.scale(dpr, dpr);
  }
  resize();
  window.addEventListener('resize', () => { ctx.resetTransform(); resize(); });

  const W = () => window.innerWidth;
  const H = () => window.innerHeight;

  // Permutation table for gradient noise
  const perm = new Uint8Array(512);
  const p    = new Uint8Array(256);
  for (let i = 0; i < 256; i++) p[i] = i;
  for (let i = 255; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [p[i], p[j]] = [p[j], p[i]];
  }
  for (let i = 0; i < 512; i++) perm[i] = p[i & 255];

  function fade(t: number) { return t * t * t * (t * (t * 6 - 15) + 10); }
  function lerp(a: number, b: number, t: number) { return a + t * (b - a); }
  function grad(h: number, x: number, y: number) {
    const u = (h & 1) ? x : -x;
    const v = (h & 2) ? y : -y;
    return u + v;
  }
  function noise(x: number, y: number) {
    const xi = Math.floor(x) & 255, yi = Math.floor(y) & 255;
    const xf = x - Math.floor(x), yf = y - Math.floor(y);
    const u = fade(xf), v = fade(yf);
    const aa = perm[perm[xi]   + yi],   ab = perm[perm[xi]   + yi + 1];
    const ba = perm[perm[xi+1] + yi],   bb = perm[perm[xi+1] + yi + 1];
    return lerp(
      lerp(grad(aa, xf,   yf),   grad(ba, xf-1, yf),   u),
      lerp(grad(ab, xf,   yf-1), grad(bb, xf-1, yf-1), u),
      v
    );
  }

  const accent  = isDark ? '#c46b4b' : '#a04525';
  const COUNT   = 400;
  const particles = Array.from({ length: COUNT }, () => ({
    x: Math.random() * W(), y: Math.random() * H(),
    vx: 0, vy: 0, life: Math.random(),
  }));

  let t = 0, raf = 0, glitchTimer = 0, glitchActive = false;

  function drawGlitch() {
    const sliceH = Math.random() * 12 + 4;
    const y      = Math.random() * H();
    const shift  = (Math.random() - 0.5) * 20;
    const imgData = ctx.getImageData(0, y * dpr, W() * dpr, sliceH * dpr);
    ctx.putImageData(imgData, shift * dpr, y * dpr);
  }

  function draw() {
    t += 0.003;
    glitchTimer++;
    if (!glitchActive && Math.random() < 0.004) glitchActive = true;
    if (glitchActive && glitchTimer % 4 === 0)  glitchActive = false;

    ctx.fillStyle = isDark ? 'rgba(15,15,15,0.18)' : 'rgba(245,244,240,0.18)';
    ctx.fillRect(0, 0, W(), H());

    for (const p of particles) {
      const angle = noise(p.x * 0.004 + t, p.y * 0.004 + t * 0.6) * Math.PI * 4;
      p.vx = p.vx * 0.84 + Math.cos(angle) * 0.6;
      p.vy = p.vy * 0.84 + Math.sin(angle) * 0.6;
      p.x += p.vx; p.y += p.vy;
      p.life += 0.004;
      if (p.x < 0 || p.x > W() || p.y < 0 || p.y > H() || p.life > 1) {
        p.x = Math.random() * W(); p.y = Math.random() * H();
        p.vx = 0; p.vy = 0; p.life = 0;
      }
      const alpha = Math.sin(p.life * Math.PI) * 0.45;
      const hex = Math.round(alpha * 255).toString(16).padStart(2, '0');
      ctx.beginPath(); ctx.arc(p.x, p.y, 1.2, 0, Math.PI * 2);
      ctx.fillStyle = `${accent}${hex}`; ctx.fill();
    }
    if (glitchActive) { drawGlitch(); drawGlitch(); }
    raf = requestAnimationFrame(draw);
  }

  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    ctx.fillStyle = isDark ? '#0f0f0f' : '#f5f4f0';
    ctx.fillRect(0, 0, W(), H());
    for (const p of particles) {
      ctx.beginPath(); ctx.arc(p.x, p.y, 1.2, 0, Math.PI * 2);
      ctx.fillStyle = isDark ? 'rgba(196,107,75,0.25)' : 'rgba(160,69,37,0.2)';
      ctx.fill();
    }
  } else {
    draw();
  }
  document.addEventListener('astro:before-swap', () => cancelAnimationFrame(raf), { once: true });
})();
</script>

<style>
  .nf {
    position: relative;
    width: 100%;
    height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #nf-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .nf__content {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    text-align: center;
    padding: 2.5rem 2rem;
    background: color-mix(in srgb, var(--color-bg) 72%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--color-border);
    border-radius: 16px;
  }

  .nf__code {
    font-family: var(--font-body);
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .nf__heading {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 400;
    color: var(--color-text);
    margin: 0;
    line-height: 1.1;
  }

  .nf__sub {
    font-family: var(--font-body);
    font-size: 0.9375rem;
    color: var(--color-muted);
    margin: 0;
  }

  .nf__home {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.5rem;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--color-muted);
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.4rem 0.8rem;
    transition: color 0.2s, border-color 0.2s;
  }
  .nf__home:hover {
    color: var(--color-text);
    border-color: var(--color-border-highlight);
  }
  .nf__home svg { width: 14px; height: 14px; }
</style>

