---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import Footer from '../../components/Footer.astro';

const experiments = [
  {
    slug:  'noise',
    tag:   'Flow Field',
    title: 'Noise Field',
    desc:  'Particles flowing through an animated Perlin noise vector field. Mouse shifts the flow.',
    preview: 'noise',
  },
  {
    slug:  'voronoi',
    tag:   'Geometry',
    title: 'Voronoi',
    desc:  'Delaunay triangulation and Voronoi cells from drifting points. Cursor adds a live node.',
    preview: 'voronoi',
  },
  {
    slug:  'trails',
    tag:   'Physics',
    title: 'Cursor Trails',
    desc:  'Spring-physics cursor trail. Each segment chases the previous with natural damping.',
    preview: 'trails',
  },
  {
    slug:  'spring',
    tag:   'Physics',
    title: 'Spring Mesh',
    desc:  'A grid of points held by springs. Click to deform — watch the oscillation decay.',
    preview: 'spring',
  },
  {
    slug:  'ascii',
    tag:   'Text',
    title: 'ASCII Field',
    desc:  'A noise flow field rendered entirely in ASCII characters. Mouse shifts the current.',
    preview: 'ascii',
  },
  {
    slug:  'type',
    tag:   'Typography',
    title: 'Kinetic Type',
    desc:  'Words orbit a gravitational centre and scatter on interaction.',
    preview: 'type',
  },
  {
    slug:  'cloth',
    tag:   'Physics',
    title: 'Cloth',
    desc:  'Verlet integration cloth. Drag to grab, right-click to cut constraints.',
    preview: 'cloth',
  },
];
---

<Layout
  title="Lab — Jon Osmond"
  description="Canvas experiments — noise fields, Voronoi diagrams, spring physics, and cursor trails."
>
  <main class="lab">
    <header class="lab__header">
      <a href="/experiments" class="lab__back">
        <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M10 3L5 8l5 5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Experiments
      </a>
      <p class="lab__eyebrow">Lab</p>
      <h1 class="lab__title">Canvas<br />Experiments</h1>
      <p class="lab__lead">
        Interactive playgrounds built directly on the browser's Canvas API —
        no frameworks, just math and pixels.
      </p>
    </header>

    <section class="lab__grid" aria-label="Experiments">
      {experiments.map(({ slug, tag, title, desc, preview }) => (
        <a href={`/lab/${slug}`} class="lab__card" data-preview={preview} transition:name={`lab-card-${slug}`}>
          <div class="lab__preview" aria-hidden="true">
            <canvas class="lab__canvas" data-preview={preview}></canvas>
          </div>
          <div class="lab__body">
            <span class="lab__tag">{tag}</span>
            <h2 class="lab__card-title" transition:name={`lab-title-${slug}`}>{title}</h2>
            <p class="lab__card-desc">{desc}</p>
            <span class="lab__arrow" aria-hidden="true">
              <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M3 8h10M9 4l4 4-4 4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
          </div>
        </a>
      ))}
    </section>
  </main>
  <Footer />
</Layout>

<script>
  const isDark = !window.matchMedia('(prefers-color-scheme: light)').matches;
  const accent  = isDark ? '#c46b4b' : '#a04525';
  const bgAlpha = isDark ? 'rgba(15,15,15,0.18)' : 'rgba(245,240,232,0.18)';

  function setup(el: HTMLCanvasElement) {
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const w = el.offsetWidth, h = el.offsetHeight;
    el.width = w * dpr; el.height = h * dpr;
    const ctx = el.getContext('2d')!;
    ctx.scale(dpr, dpr);
    return { ctx, w, h };
  }

  // ── Noise preview (flow field particles) ──────────────────────────────────
  function initNoise(canvas: HTMLCanvasElement): () => void {
    const { ctx, w, h } = setup(canvas);
    const pts = Array.from({ length: 100 }, () => ({
      x: Math.random() * w, y: Math.random() * h,
      vx: 0, vy: 0,
    }));
    let t = 0, raf = 0;

    function draw() {
      t += 0.003;
      ctx.fillStyle = bgAlpha;
      ctx.fillRect(0, 0, w, h);
      for (const p of pts) {
        const angle = Math.sin(p.x * 0.04 + t) * Math.PI + Math.cos(p.y * 0.04 + t * 0.7) * Math.PI;
        p.vx = p.vx * 0.85 + Math.cos(angle) * 0.4;
        p.vy = p.vy * 0.85 + Math.sin(angle) * 0.4;
        p.x += p.vx; p.y += p.vy;
        if (p.x < 0) p.x = w; if (p.x > w) p.x = 0;
        if (p.y < 0) p.y = h; if (p.y > h) p.y = 0;
        ctx.beginPath();
        ctx.arc(p.x, p.y, 1, 0, Math.PI * 2);
        ctx.fillStyle = isDark ? 'rgba(196,107,75,0.6)' : 'rgba(160,69,37,0.5)';
        ctx.fill();
      }
      raf = requestAnimationFrame(draw);
    }
    draw();
    return () => cancelAnimationFrame(raf);
  }

  // ── Voronoi preview ────────────────────────────────────────────────────────
  function initVoronoi(canvas: HTMLCanvasElement): () => void {
    const { ctx, w, h } = setup(canvas);
    const pts = Array.from({ length: 12 }, () => ({
      x: Math.random() * w, y: Math.random() * h,
      vx: (Math.random() - 0.5) * 0.5, vy: (Math.random() - 0.5) * 0.5,
    }));
    let raf = 0;

    async function loadAndDraw() {
      const { Delaunay } = await import('d3-delaunay');
      function draw() {
        for (const p of pts) {
          p.x += p.vx; p.y += p.vy;
          if (p.x < 0 || p.x > w) p.vx *= -1;
          if (p.y < 0 || p.y > h) p.vy *= -1;
        }
        ctx.clearRect(0, 0, w, h);
        const d = Delaunay.from(pts.map(p => [p.x, p.y]));
        const v = d.voronoi([0, 0, w, h]);
        ctx.strokeStyle = isDark ? 'rgba(245,244,240,0.15)' : 'rgba(26,23,20,0.12)';
        ctx.lineWidth = 1;
        ctx.beginPath();
        v.render(ctx);
        ctx.stroke();
        for (const p of pts) {
          ctx.beginPath(); ctx.arc(p.x, p.y, 2.5, 0, Math.PI * 2);
          ctx.fillStyle = accent; ctx.fill();
        }
        raf = requestAnimationFrame(draw);
      }
      draw();
    }
    loadAndDraw();
    return () => cancelAnimationFrame(raf);
  }

  // ── Trails preview ─────────────────────────────────────────────────────────
  function initTrails(canvas: HTMLCanvasElement): () => void {
    const { ctx, w, h } = setup(canvas);
    const N = 18;
    const segs = Array.from({ length: N }, (_, i) => ({
      x: w / 2 + Math.cos(i * 0.4) * 20,
      y: h / 2 + Math.sin(i * 0.4) * 20,
      vx: 0, vy: 0,
    }));
    let target = { x: w / 2, y: h / 2 };
    let t = 0, raf = 0;

    function draw() {
      t += 0.025;
      target.x = w * (0.5 + 0.35 * Math.sin(t));
      target.y = h * (0.5 + 0.3  * Math.cos(t * 0.8));
      ctx.fillStyle = bgAlpha;
      ctx.fillRect(0, 0, w, h);
      let prev = target;
      for (let i = 0; i < segs.length; i++) {
        const s = segs[i];
        s.vx = s.vx * 0.75 + (prev.x - s.x) * 0.18;
        s.vy = s.vy * 0.75 + (prev.y - s.y) * 0.18;
        s.x += s.vx; s.y += s.vy;
        const alpha = 1 - i / N;
        ctx.beginPath(); ctx.arc(s.x, s.y, 2.5 * (1 - i / N * 0.6), 0, Math.PI * 2);
        const hex = Math.round(alpha * 200).toString(16).padStart(2, '0');
        ctx.fillStyle = `${accent}${hex}`; ctx.fill();
        prev = s;
      }
      raf = requestAnimationFrame(draw);
    }
    draw();
    return () => cancelAnimationFrame(raf);
  }

  // ── Spring preview ─────────────────────────────────────────────────────────
  function initSpring(canvas: HTMLCanvasElement): () => void {
    const { ctx, w, h } = setup(canvas);
    const COLS = 8, ROWS = 5;
    const pts = [] as { x: number; y: number; ox: number; oy: number; vx: number; vy: number }[];
    for (let r = 0; r <= ROWS; r++) {
      for (let c = 0; c <= COLS; c++) {
        const ox = (c / COLS) * w;
        const oy = (r / ROWS) * h;
        pts.push({ x: ox, y: oy, ox, oy, vx: 0, vy: 0 });
      }
    }
    let raf = 0, t = 0;

    // Auto-poke a random point every 2s
    function poke() {
      const idx = Math.floor(Math.random() * pts.length);
      pts[idx].vx += (Math.random() - 0.5) * 8;
      pts[idx].vy += (Math.random() - 0.5) * 8;
    }
    poke();
    const pokeId = setInterval(poke, 1800);

    function idx(c: number, r: number) { return r * (COLS + 1) + c; }

    function draw() {
      t++;
      ctx.clearRect(0, 0, w, h);
      // Spring physics
      for (const p of pts) {
        p.vx += (p.ox - p.x) * 0.06;
        p.vy += (p.oy - p.y) * 0.06;
        p.vx *= 0.88; p.vy *= 0.88;
        p.x += p.vx; p.y += p.vy;
      }
      // Draw edges
      ctx.strokeStyle = isDark ? 'rgba(245,244,240,0.12)' : 'rgba(26,23,20,0.1)';
      ctx.lineWidth = 1;
      for (let r = 0; r <= ROWS; r++) {
        for (let c = 0; c <= COLS; c++) {
          if (c < COLS) { ctx.beginPath(); ctx.moveTo(pts[idx(c,r)].x, pts[idx(c,r)].y); ctx.lineTo(pts[idx(c+1,r)].x, pts[idx(c+1,r)].y); ctx.stroke(); }
          if (r < ROWS) { ctx.beginPath(); ctx.moveTo(pts[idx(c,r)].x, pts[idx(c,r)].y); ctx.lineTo(pts[idx(c,r+1)].x, pts[idx(c,r+1)].y); ctx.stroke(); }
        }
      }
      // Draw nodes
      for (const p of pts) {
        const disp = Math.hypot(p.x - p.ox, p.y - p.oy);
        const a = Math.min(disp / 6, 1);
        const hex = Math.round(a * 200 + 55).toString(16).padStart(2, '0');
        ctx.beginPath(); ctx.arc(p.x, p.y, 1.8, 0, Math.PI * 2);
        ctx.fillStyle = `${accent}${hex}`; ctx.fill();
      }
      raf = requestAnimationFrame(draw);
    }
    draw();
    return () => { cancelAnimationFrame(raf); clearInterval(pokeId); };
  }

  // ── ASCII preview ──────────────────────────────────────────────────────────
  function initAscii(canvas: HTMLCanvasElement): () => void {
    const { ctx, w, h } = setup(canvas);
    const FLOW = ['·','╌','─','╌','│','╎','│','╎','╱','╲','╱','╲','✦','✧','◆','◇'];
    const perm2 = new Uint8Array(512);
    { const p2 = new Uint8Array(256);
      for (let i = 0; i < 256; i++) p2[i] = i;
      for (let i = 255; i > 0; i--) { const j = Math.floor(Math.random()*(i+1)); [p2[i], p2[j]] = [p2[j], p2[i]]; }
      for (let i = 0; i < 512; i++) perm2[i] = p2[i & 255]; }
    function fade2(t: number) { return t*t*t*(t*(t*6-15)+10); }
    function lerp2(a: number, b: number, t: number) { return a+t*(b-a); }
    function grad2(hh: number, x: number, y: number) { return ((hh&1)?x:-x)+((hh&2)?y:-y); }
    function noise2(x: number, y: number) {
      const xi=Math.floor(x)&255, yi=Math.floor(y)&255;
      const xf=x-Math.floor(x), yf=y-Math.floor(y);
      const u=fade2(xf), v=fade2(yf);
      const aa=perm2[perm2[xi]+yi], ab=perm2[perm2[xi]+yi+1];
      const ba=perm2[perm2[xi+1]+yi], bb=perm2[perm2[xi+1]+yi+1];
      return lerp2(lerp2(grad2(aa,xf,yf),grad2(ba,xf-1,yf),u),lerp2(grad2(ab,xf,yf-1),grad2(bb,xf-1,yf-1),u),v);
    }
    const CHAR_W = 7, CHAR_H = 12;
    const cols2 = Math.floor(w / CHAR_W), rows2 = Math.floor(h / CHAR_H);
    let t2 = 0, raf = 0;
    ctx.font = `500 10px monospace`;
    ctx.textBaseline = 'top';
    function draw2() {
      t2 += 0.01;
      ctx.clearRect(0, 0, w, h);
      ctx.fillStyle = isDark ? 'rgba(136,136,132,0.55)' : 'rgba(136,136,132,0.5)';
      for (let r = 0; r < rows2; r++) {
        for (let c = 0; c < cols2; c++) {
          const n = noise2(c * 0.15 + t2, r * 0.15 + t2 * 0.5);
          const bucket = Math.floor(((n / (Math.PI*2) + 0.5) % 1) * FLOW.length);
          const ch = FLOW[bucket < 0 ? 0 : bucket];
          ctx.fillText(ch, c * CHAR_W, r * CHAR_H);
        }
      }
      // Accent hotspot
      const hx = (Math.sin(t2 * 0.7) * 0.3 + 0.5) * cols2;
      const hy = (Math.cos(t2 * 0.5) * 0.3 + 0.5) * rows2;
      ctx.fillStyle = accent;
      for (let r = -2; r <= 2; r++) {
        for (let c = -2; c <= 2; c++) {
          const rc = Math.round(hx + c), rr = Math.round(hy + r);
          if (rc < 0 || rc >= cols2 || rr < 0 || rr >= rows2) continue;
          const n = noise2(rc * 0.15 + t2, rr * 0.15 + t2 * 0.5);
          const bucket = Math.floor(((n / (Math.PI*2) + 0.5) % 1) * FLOW.length);
          ctx.fillText(FLOW[bucket < 0 ? 0 : bucket], rc * CHAR_W, rr * CHAR_H);
        }
      }
      raf = requestAnimationFrame(draw2);
    }
    draw2();
    return () => cancelAnimationFrame(raf);
  }

  // ── Type preview ───────────────────────────────────────────────────────────
  function initType(canvas: HTMLCanvasElement): () => void {
    const { ctx, w, h } = setup(canvas);
    const words = ['interface','design','motion','system','craft','rhythm','signal','form'];
    const pts2 = words.map((word, i) => {
      const angle2 = (i / words.length) * Math.PI * 2;
      const r2 = Math.min(w, h) * 0.3;
      return { word, x: w/2 + Math.cos(angle2)*r2, y: h/2 + Math.sin(angle2)*r2,
               vx: 0, vy: 0, angle2, r2,
               speed: 0.008 * (i % 2 ? 1 : -1),
               size: i % 3 === 0 ? 11 : 9 };
    });
    let raf = 0;
    function draw3() {
      ctx.clearRect(0, 0, w, h);
      ctx.strokeStyle = isDark ? 'rgba(245,244,240,0.05)' : 'rgba(26,23,20,0.05)';
      ctx.lineWidth = 0.5;
      ctx.beginPath(); ctx.arc(w/2, h/2, Math.min(w,h)*0.3, 0, Math.PI*2); ctx.stroke();
      ctx.beginPath(); ctx.arc(w/2, h/2, 2, 0, Math.PI*2);
      ctx.fillStyle = accent; ctx.fill();
      for (const p of pts2) {
        p.angle2 += p.speed;
        p.x = w/2 + Math.cos(p.angle2)*p.r2;
        p.y = h/2 + Math.sin(p.angle2)*p.r2;
        ctx.font = `400 ${p.size}px var(--font-body,sans-serif)`;
        ctx.textAlign = 'center'; ctx.textBaseline = 'middle';
        ctx.fillStyle = isDark ? 'rgba(136,136,132,0.7)' : 'rgba(136,136,132,0.8)';
        ctx.fillText(p.word, p.x, p.y);
      }
      raf = requestAnimationFrame(draw3);
    }
    draw3();
    return () => cancelAnimationFrame(raf);
  }

  // ── Cloth preview ──────────────────────────────────────────────────────────
  function initCloth(canvas: HTMLCanvasElement): () => void {
    const { ctx, w, h } = setup(canvas);
    const COLS2 = 14, ROWS2 = 9;
    const sX = w * 0.7 / COLS2, sY = sX;
    const startX = (w - sX*(COLS2-1))/2, startY = h*0.08;
    const pts3: {x:number;y:number;px:number;py:number;pinned:boolean}[] = [];
    for (let r=0;r<ROWS2;r++) for (let c=0;c<COLS2;c++) {
      const x=startX+c*sX, y=startY+r*sY;
      pts3.push({x,y,px:x,py:y,pinned:r===0&&c%3===0});
    }
    const cons2: {p0:typeof pts3[0];p1:typeof pts3[0];rest:number;active:boolean}[] = [];
    const idx2=(r:number,c:number)=>r*COLS2+c;
    for (let r=0;r<ROWS2;r++) for (let c=0;c<COLS2;c++) {
      if (c<COLS2-1) cons2.push({p0:pts3[idx2(r,c)],p1:pts3[idx2(r,c+1)],rest:sX,active:true});
      if (r<ROWS2-1) cons2.push({p0:pts3[idx2(r,c)],p1:pts3[idx2(r+1,c)],rest:sY,active:true});
    }
    let raf = 0, tickN = 0;
    function poke2() {
      const ri = Math.floor(Math.random()*(ROWS2-1))+1;
      const ci = Math.floor(Math.random()*COLS2);
      pts3[idx2(ri,ci)].vx += (Math.random()-0.5)*6;
    }
    poke2();
    function draw4() {
      tickN++;
      if (tickN % 90 === 0) poke2();
      for (const p of pts3) {
        if (p.pinned) continue;
        const vx=(p.x-p.px)*0.99, vy=(p.y-p.py)*0.99;
        p.px=p.x; p.py=p.y; p.x+=vx; p.y+=vy+0.35;
        if (p.y>h) { p.y=h; p.py=p.y+vy*0.3; }
      }
      for (let it=0;it<3;it++) for (const c of cons2) {
        if (!c.active) continue;
        const dx=c.p1.x-c.p0.x, dy=c.p1.y-c.p0.y, d=Math.hypot(dx,dy)||0.001;
        if (d>sX*3.5){c.active=false;continue;}
        const diff=(d-c.rest)/d*0.5;
        const ox=dx*diff, oy=dy*diff;
        if (!c.p0.pinned){c.p0.x+=ox;c.p0.y+=oy;}
        if (!c.p1.pinned){c.p1.x-=ox;c.p1.y-=oy;}
      }
      ctx.clearRect(0,0,w,h);
      ctx.strokeStyle = isDark ? 'rgba(245,244,240,0.3)' : 'rgba(26,23,20,0.25)';
      ctx.lineWidth=0.7;
      for (const c of cons2) {
        if(!c.active) continue;
        ctx.beginPath(); ctx.moveTo(c.p0.x,c.p0.y); ctx.lineTo(c.p1.x,c.p1.y); ctx.stroke();
      }
      ctx.fillStyle = accent;
      for (const p of pts3) { if(!p.pinned) continue; ctx.beginPath(); ctx.arc(p.x,p.y,2,0,Math.PI*2); ctx.fill(); }
      raf = requestAnimationFrame(draw4);
    }
    draw4();
    return () => cancelAnimationFrame(raf);
  }

  const cleanups: Array<() => void> = [];
  document.querySelectorAll<HTMLCanvasElement>('.lab__canvas').forEach(canvas => {
    const t = canvas.dataset.preview;
    if (t === 'noise')   cleanups.push(initNoise(canvas));
    if (t === 'voronoi') cleanups.push(initVoronoi(canvas));
    if (t === 'trails')  cleanups.push(initTrails(canvas));
    if (t === 'spring')  cleanups.push(initSpring(canvas));
    if (t === 'ascii')   cleanups.push(initAscii(canvas));
    if (t === 'type')    cleanups.push(initType(canvas));
    if (t === 'cloth')   cleanups.push(initCloth(canvas));
  });
  document.addEventListener('astro:before-swap', () => cleanups.forEach(fn => fn()), { once: true });
</script>

<style>
  .lab {
    padding: clamp(2rem, 6vw, 5rem);
    max-width: 72rem;
    width: 100%;
  }

  .lab__back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-decoration: none;
    transition: color 0.2s;
    margin-bottom: 3rem;
  }
  .lab__back:hover { color: var(--color-text); }
  .lab__back svg { width: 14px; height: 14px; }

  .lab__header { margin-bottom: clamp(3rem, 6vw, 5rem); }

  .lab__eyebrow {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin: 0 0 1rem;
  }

  .lab__title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 400;
    line-height: 1.05;
    color: var(--color-text);
    margin: 0 0 1.25rem;
  }

  .lab__lead {
    font-size: 1rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0;
    max-width: 42ch;
  }

  .lab__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  @media (max-width: 640px) { .lab__grid { grid-template-columns: 1fr; } }

  .lab__card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    text-decoration: none;
    overflow: hidden;
    transition: border-color 0.2s, transform 0.2s;
  }
  .lab__card:hover { border-color: var(--color-border-highlight); transform: translateY(-2px); }
  .lab__card:focus-visible { outline: 2px solid var(--color-accent); outline-offset: 2px; }

  .lab__preview {
    width: 100%;
    aspect-ratio: 16 / 7;
    position: relative;
    overflow: hidden;
    background: var(--color-bg);
  }

  .lab__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .lab__body {
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    flex: 1;
  }

  .lab__tag {
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .lab__card-title {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 400;
    color: var(--color-text);
    margin: 0;
  }

  .lab__card-desc {
    font-size: 0.875rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin: 0.25rem 0 0;
    flex: 1;
  }

  .lab__arrow {
