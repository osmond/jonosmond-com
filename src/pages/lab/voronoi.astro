---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Voronoi — Lab — Jon Osmond" description="Delaunay triangulation and Voronoi cells from drifting points.">
  <div class="lab-exp">
    <nav class="lab-exp__nav">
      <a href="/lab" class="lab-exp__back">
        <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
          <path d="M10 3L5 8l5 5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        Lab
      </a>
      <span class="lab-exp__name">Voronoi</span>
    </nav>
    <canvas id="exp-canvas" aria-label="Interactive Voronoi diagram with drifting points"></canvas>
    <div class="lab-exp__info" id="exp-info">
      <strong>Voronoi</strong>
      Each region shows the area closest to one point. Move your cursor — it becomes a live node that reshapes the diagram.
      <button class="lab-exp__dismiss" id="dismiss-info" aria-label="Dismiss description">✕</button>
    </div>
  </div>
</Layout>

<script>
  import { Delaunay } from 'd3-delaunay';

  const canvas = document.getElementById('exp-canvas') as HTMLCanvasElement;
  const ctx    = canvas.getContext('2d')!;
  const dpr    = Math.min(window.devicePixelRatio || 1, 2);
  const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const isDark = !window.matchMedia('(prefers-color-scheme: light)').matches;

  let W = 0, H = 0;
  function resize() {
    W = canvas.offsetWidth; H = canvas.offsetHeight;
    canvas.width = W * dpr; canvas.height = H * dpr;
    ctx.scale(dpr, dpr);
  }
  resize();
  window.addEventListener('resize', resize, { passive: true });

  // ─── Points ────────────────────────────────────────────────────────────────
  const N = 28;
  const pts = Array.from({ length: N }, () => ({
    x:  Math.random() * W,
    y:  Math.random() * H,
    vx: (Math.random() - 0.5) * 0.6,
    vy: (Math.random() - 0.5) * 0.6,
  }));

  // Cursor point (last slot — starts off-screen)
  let cursorX = -1000, cursorY = -1000;
  canvas.addEventListener('mousemove', e => {
    const r = canvas.getBoundingClientRect();
    cursorX = e.clientX - r.left;
    cursorY = e.clientY - r.top;
  });
  canvas.addEventListener('mouseleave', () => { cursorX = -1000; cursorY = -1000; });

  // Hue palette for cells — derived from accent
  const HUE_BASE = isDark ? 20 : 22; // warm hue

  function cellFill(i: number, total: number): string {
    const hue = (HUE_BASE + (i / total) * 40) % 360;
    const sat = 30 + (i % 3) * 8;
    const lit = isDark ? 10 + (i % 4) * 3 : 88 - (i % 4) * 3;
    return `hsl(${hue}, ${sat}%, ${lit}%)`;
  }

  // ─── Animation ─────────────────────────────────────────────────────────────
  let raf = 0;

  function draw() {
    // Update positions
    for (const p of pts) {
      p.x += p.vx; p.y += p.vy;
      if (p.x < 0 || p.x > W) { p.vx *= -1; p.x = Math.max(0, Math.min(W, p.x)); }
      if (p.y < 0 || p.y > H) { p.vy *= -1; p.y = Math.max(0, Math.min(H, p.y)); }
    }

    const allPts = [...pts.map(p => [p.x, p.y] as [number, number]), [cursorX, cursorY] as [number, number]];
    const total  = allPts.length;

    ctx.clearRect(0, 0, W, H);

    try {
      const delaunay = Delaunay.from(allPts);
      const voronoi  = delaunay.voronoi([0, 0, W, H]);

      // Fill each cell
      for (let i = 0; i < total; i++) {
        const path = new Path2D();
        voronoi.renderCell(i, path);
        const isCursor = i === total - 1;
        ctx.fillStyle = isCursor
          ? (isDark ? 'rgba(196,107,75,0.18)' : 'rgba(160,69,37,0.12)')
          : cellFill(i, total);
        ctx.fill(path);
      }

      // Stroke all edges
      ctx.strokeStyle = isDark ? 'rgba(245,244,240,0.12)' : 'rgba(26,23,20,0.1)';
      ctx.lineWidth   = 1;
      ctx.beginPath();
      voronoi.render(ctx);
      ctx.stroke();

      // Delaunay triangulation (subtle)
      ctx.strokeStyle = isDark ? 'rgba(245,244,240,0.04)' : 'rgba(26,23,20,0.04)';
      ctx.lineWidth   = 0.5;
      ctx.beginPath();
      delaunay.render(ctx);
      ctx.stroke();
    } catch { /* skip frame on degenerate input */ }

    // Draw points
    for (let i = 0; i < pts.length; i++) {
      ctx.beginPath();
      ctx.arc(pts[i].x, pts[i].y, 3, 0, Math.PI * 2);
      ctx.fillStyle = isDark ? '#c46b4b' : '#a04525';
      ctx.fill();
    }

    // Cursor point
    if (cursorX > 0) {
      ctx.beginPath();
      ctx.arc(cursorX, cursorY, 5, 0, Math.PI * 2);
      ctx.strokeStyle = isDark ? '#c46b4b' : '#a04525';
      ctx.lineWidth = 1.5;
      ctx.stroke();
    }

    raf = requestAnimationFrame(draw);
  }

  if (prefersReduced) {
    draw(); cancelAnimationFrame(raf);
  } else {
    draw();
  }

  document.getElementById('dismiss-info')?.addEventListener('click', () => {
    document.getElementById('exp-info')?.remove();
  });

  document.addEventListener('astro:before-swap', () => {
    cancelAnimationFrame(raf);
    window.removeEventListener('resize', resize);
  }, { once: true });
</script>

<style is:global>
  html, body { margin: 0; padding: 0; overflow: hidden; }
</style>

<style>
  .lab-exp {
    position: relative;
    width: 100vw;
    height: 100svh;
    overflow: hidden;
    background: var(--color-bg);
  }
  #exp-canvas { display: block; width: 100%; height: 100%; cursor: crosshair; }
  .lab-exp__nav {
    position: absolute; top: 1.25rem; left: 1.25rem; z-index: 10;
    display: flex; align-items: center; gap: 0.875rem;
  }
  .lab-exp__back {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-size: 0.8125rem; color: var(--color-muted); text-decoration: none;
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: 6px; padding: 0.35rem 0.7rem;
    transition: color 0.2s, border-color 0.2s; backdrop-filter: blur(8px);
  }
  .lab-exp__back:hover { color: var(--color-text); border-color: var(--color-border-highlight); }
  .lab-exp__back svg { width: 13px; height: 13px; }
  .lab-exp__name { font-size: 0.8125rem; color: var(--color-muted); }
  .lab-exp__info {
    position: absolute; bottom: 1.5rem; left: 1.5rem; right: 1.5rem;
    max-width: 36rem; font-size: 0.8125rem; color: var(--color-muted);
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: 8px; padding: 0.75rem 2.5rem 0.75rem 1rem; z-index: 10; line-height: 1.5;
  }
  .lab-exp__info strong { color: var(--color-text); display: block; margin-bottom: 0.25rem; font-size: 0.875rem; }
  .lab-exp__dismiss {
    position: absolute; top: 0.6rem; right: 0.75rem;
    background: none; border: none; color: var(--color-muted);
    cursor: pointer; font-size: 0.75rem; padding: 0.2rem; transition: color 0.2s;
  }
  .lab-exp__dismiss:hover { color: var(--color-text); }
</style>
