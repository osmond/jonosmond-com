---
export const prerender = true;
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const showDrafts = import.meta.env.DEV && Astro.url.searchParams.get('preview') === '1';
const posts = (await getCollection('writing', e => showDrafts || !e.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="Writing — Jon Osmond" description="Notes on design, code, and craft.">
  <main class="wr">
    <header class="wr__header">
      <a href="/" class="back-link">← Home</a>
      <p class="eyebrow">Writing</p>
      <h1 class="wr__title">Notes</h1>
      <p class="wr__sub">On design, code, and the space between them.</p>
    </header>

    <ul class="wr__list" role="list">
      {posts.map(post => {
        const d = post.data.date;
        const dateStr = d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
        return (
          <li class="wr__item">
            <a href={`/writing/${post.id}`} class="wr__link">
              <time class="wr__date" datetime={d.toISOString()}>{dateStr}</time>
              <h2 class="wr__post-title">{post.data.title}</h2>
              <p class="wr__desc">{post.data.description}</p>
              {post.data.tags.length > 0 && (
                <ul class="wr__tags" role="list">
                  {post.data.tags.map(tag => <li class="wr__tag"><a href={`/writing/tag/${tag}`} class="wr__tag-link">{tag}</a></li>)}
                </ul>
              )}
            </a>
          </li>
        );
      })}
    </ul>
  </main>
</Layout>

<style>
  .wr {
    padding: clamp(4rem, 8vw, 7rem) clamp(2rem, 6vw, 5rem);
    max-width: 720px;
    margin: 0 auto;
  }
  .wr__header { margin-bottom: 4rem; }
  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.35rem 0.7rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--color-text); }
  .eyebrow {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }
  .wr__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 0.75rem;
  }
  .wr__sub {
    color: var(--color-muted);
    font-size: 1rem;
  }
  .wr__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .wr__item { border-top: 1px solid var(--color-border); }
  .wr__item:last-child { border-bottom: 1px solid var(--color-border); }
  .wr__link {
    display: block;
    padding: 1.5rem 0;
    text-decoration: none;
    color: inherit;
    transition: padding-left 0.2s;
  }
  .wr__link:hover { padding-left: 0.5rem; }
  .wr__date {
    display: block;
    font-size: 0.8rem;
    color: var(--color-muted);
    margin-bottom: 0.4rem;
    font-variant-numeric: tabular-nums;
  }
  .wr__post-title {
    font-size: 1.15rem;
    font-weight: 500;
    margin-bottom: 0.4rem;
    line-height: 1.3;
  }
  .wr__link:hover .wr__post-title { color: var(--color-accent); }
  .wr__desc {
    font-size: 0.9rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .wr__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .wr__tag { display: contents; }
  .wr__tag-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    padding: 0.15rem 0.65rem;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
  }
  .wr__tag-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>
