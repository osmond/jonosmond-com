---
export const prerender = true;
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('writing', e => import.meta.env.DEV || !e.data.draft);
  return posts.map(post => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { Content } = await render(post);
const dateStr = post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const wordCount = post.body?.split(/\s+/).filter(Boolean).length ?? 0;
const readingTime = Math.max(1, Math.ceil(wordCount / 200));
---

<Layout
  title={`${post.data.title} — Jon Osmond`}
  description={post.data.description}
  ogTitle={post.data.title}
  ogDescription={post.data.description}
  ogType="article"
>
  <main class="post">
    <nav class="post__nav">
      <a href="/writing" class="back-link">← Writing</a>
    </nav>

    <header class="post__header">
      {post.data.tags.length > 0 && (
        <ul class="post__tags" role="list">
          {post.data.tags.map(tag => <li class="post__tag"><a href={`/writing/tag/${tag}`} class="post__tag-link">{tag}</a></li>)}
        </ul>
      )}
      <h1 class="post__title">{post.data.title}</h1>
      <p class="post__desc">{post.data.description}</p>
      <div class="post__meta">
        <time class="post__date" datetime={post.data.date.toISOString()}>{dateStr}</time>
        <span class="post__sep" aria-hidden="true">·</span>
        <span class="post__reading-time">{readingTime} min read</span>
      </div>
    </header>

    <article class="post__body prose">
      <Content />
    </article>

  </main>
</Layout>

<style>
  .post {
    padding: clamp(4rem, 8vw, 7rem) clamp(2rem, 6vw, 5rem);
    max-width: 680px;
    margin: 0 auto;
  }
  .post__nav { margin-bottom: 3rem; }
  .back-link {
    display: inline-block;
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.35rem 0.7rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--color-text); }
  .post__header { margin-bottom: 3rem; }
  .post__tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
  }
  .post__tag { display: contents; }
  .post__tag-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 100px;
    padding: 0.15rem 0.65rem;
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
  }
  .post__tag-link:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .post__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.75rem);
    font-weight: 400;
    line-height: 1.15;
    margin-bottom: 0.75rem;
  }
  .post__desc {
    font-size: 1rem;
    color: var(--color-muted);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .post__meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }
  .post__sep { opacity: 0.4; }
  .post__date, .post__reading-time { font-size: 0.8rem; color: var(--color-muted); }
  /* Prose styles */
  .prose {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text);
  }
  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 400;
    margin: 2.5rem 0 0.75rem;
    color: var(--color-text);
  }
  .prose :global(h3) {
    font-size: 1.1rem;
    font-weight: 600;
    margin: 2rem 0 0.5rem;
  }
  .prose :global(p) { margin: 0 0 1.25rem; }
  .prose :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose :global(strong) { font-weight: 600; }
  .prose :global(em) { font-style: italic; color: var(--color-muted); }
  .prose :global(ul), .prose :global(ol) {
    margin: 0 0 1.25rem 1.25rem;
    line-height: 1.8;
  }
  .prose :global(li) { margin-bottom: 0.3rem; }
  .prose :global(code) {
    font-family: 'Fira Code', 'JetBrains Mono', monospace;
    font-size: 0.85em;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }
  .prose :global(pre) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    overflow-x: auto;
    margin: 0 0 1.5rem;
    font-size: 0.85rem;
    line-height: 1.65;
  }
  .prose :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
  }
  .prose :global(blockquote) {
    border-left: 2px solid var(--color-accent);
    padding-left: 1.25rem;
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    font-style: italic;
  }
  .prose :global(.car-switcher) {
    --car-edge: rgb(245 244 240 / 0.3);
    --car-glow: rgb(245 244 240 / 0.09);
    --500c-accent: #a9475c;
    --abarth-accent: #d95038;
    width: min(900px, calc(100vw - 2rem));
    margin: 2rem 0 2.75rem 50%;
    transform: translateX(-50%);
  }
  .prose :global(.car-switcher__stage) {
    position: relative;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    isolation: isolate;
    border: 1px solid var(--color-border);
    border-radius: 16px 16px 0 0;
    background:
      radial-gradient(ellipse at 50% 56%, var(--car-glow), transparent 65%),
      linear-gradient(180deg, transparent 68%, rgb(255 255 255 / 0.025));
    user-select: none;
  }
  .prose :global(.car-switcher__stage:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .prose :global(.car-switcher__stage::after) {
    content: '';
    position: absolute;
    z-index: 0;
    right: 10%;
    bottom: 18%;
    left: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--color-border), transparent);
    pointer-events: none;
  }
  .prose :global(.car-switcher__car) {
    position: absolute;
    z-index: 1;
    inset: 0;
    overflow: hidden;
    visibility: hidden;
    opacity: 0;
    transform: translateX(0) scale(0.97);
    transition: opacity 220ms ease, transform 340ms cubic-bezier(0.2, 0.75, 0.25, 1);
    will-change: opacity, transform;
  }
  .prose :global(.car-switcher__car.is-active),
  .prose :global(.car-switcher__car.is-entering),
  .prose :global(.car-switcher__car.is-leaving) {
    visibility: visible;
  }
  .prose :global(.car-switcher__car.is-active) {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
  .prose :global(.car-switcher__stage[data-direction='next'] .car-switcher__car.is-leaving) {
    opacity: 0;
    transform: translateX(-105%) scale(0.95);
  }
  .prose :global(.car-switcher__stage[data-direction='next'] .car-switcher__car.is-entering) {
    opacity: 0;
    transform: translateX(105%) scale(0.95);
  }
  .prose :global(.car-switcher__stage[data-direction='previous'] .car-switcher__car.is-leaving) {
    opacity: 0;
    transform: translateX(105%) scale(0.95);
  }
  .prose :global(.car-switcher__stage[data-direction='previous'] .car-switcher__car.is-entering) {
    opacity: 0;
    transform: translateX(-105%) scale(0.95);
  }
  .prose :global(.car-switcher__car img) {
    position: absolute;
    top: 50%;
    width: 200%;
    max-width: none;
    height: auto;
    transform: translateY(-50%);
    filter:
      drop-shadow(0 0 1px var(--car-edge))
      drop-shadow(0 14px 20px rgb(0 0 0 / 0.28));
  }
  .prose :global(.car-switcher__car--500c img) { left: 0; }
  .prose :global(.car-switcher__car--abarth img) { right: 0; }
  .prose :global(.car-switcher__badge) {
    position: absolute;
    z-index: 2;
    top: 0.75rem;
    left: 50%;
    padding: 0.32rem 0.65rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: rgb(15 15 15 / 0.72);
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.15);
    backdrop-filter: blur(10px);
    transform: translateX(-50%);
    font-size: 0.625rem;
    font-weight: 650;
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    pointer-events: none;
  }
  .prose :global(.car-switcher__car--500c .car-switcher__badge) { color: #e19aaa; }
  .prose :global(.car-switcher__car--abarth .car-switcher__badge) { color: #f08a78; }
  .prose :global(.car-switcher__arrow) {
    position: absolute;
    z-index: 4;
    top: 0.75rem;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 0.3);
    border-radius: 50%;
    color: #f5f4f0;
    background: rgb(15 15 15 / 0.68);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.24);
    backdrop-filter: blur(10px);
    transform: none;
    font: inherit;
    font-size: 1.8rem;
    line-height: 1;
    cursor: pointer;
    transition: border-color 160ms, background 160ms, transform 160ms;
  }
  .prose :global(.car-switcher__arrow:hover) {
    border-color: rgb(255 255 255 / 0.7);
    background: linear-gradient(135deg, rgb(169 71 92 / 0.92), rgb(217 80 56 / 0.92));
  }
  .prose :global(.car-switcher__arrow:active) {
    transform: scale(0.93);
  }
  .prose :global(.car-switcher__arrow:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }
  .prose :global(.car-switcher__arrow--previous) { left: 0.85rem; }
  .prose :global(.car-switcher__arrow--next) { right: 0.85rem; }
  .prose :global(.car-switcher__status) {
    position: absolute;
    z-index: 4;
    bottom: 0.65rem;
    left: 50%;
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.34rem 0.65rem;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 999px;
    color: #f5f4f0;
    background: rgb(15 15 15 / 0.72);
    backdrop-filter: blur(10px);
    transform: translateX(-50%);
    white-space: nowrap;
    pointer-events: none;
  }
  .prose :global(.car-switcher__status span) {
    color: rgb(245 244 240 / 0.64);
    font-size: 0.575rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .prose :global(.car-switcher__status strong) {
    font-size: 0.7rem;
    font-weight: 650;
  }
  .prose :global(.car-switcher__choices) {
    display: grid;
    grid-template-columns: 1fr 1fr;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-top: 0;
    border-radius: 0 0 12px 12px;
    background: var(--color-surface);
  }
  .prose :global(.car-switcher__choices button) {
    padding: 0.7rem 0.85rem;
    border: 0;
    border-bottom: 3px solid transparent;
    color: var(--color-muted);
    background: transparent;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 650;
    cursor: pointer;
    transition: color 160ms, background 160ms, border-color 160ms;
  }
  .prose :global(.car-switcher__choices button + button) {
    border-left: 1px solid var(--color-border);
  }
  .prose :global(.car-switcher__choices button span) {
    display: block;
    margin-bottom: 0.08rem;
    font-size: 0.575rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0.65;
  }
  .prose :global(.car-switcher__choices button:hover) {
    color: var(--color-text);
    background: rgb(255 255 255 / 0.025);
  }
  .prose :global(.car-switcher__choices button[data-car-switcher-select='500c'][aria-pressed='true']) {
    border-bottom-color: var(--500c-accent);
    color: var(--color-text);
    background: rgb(169 71 92 / 0.08);
  }
  .prose :global(.car-switcher__choices button[data-car-switcher-select='abarth'][aria-pressed='true']) {
    border-bottom-color: var(--abarth-accent);
    color: var(--color-text);
    background: rgb(217 80 56 / 0.08);
  }
  .prose :global(.car-switcher__choices button:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: -3px;
  }
  .prose :global(.car-switcher figcaption) {
    margin-top: 0.55rem;
    text-align: center;
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.5;
  }
  .prose :global(.exhaust-player) {
    margin: 1.75rem 0 2rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 12px;
    background:
      radial-gradient(circle at 100% 0, rgb(217 80 56 / 0.12), transparent 42%),
      var(--color-surface);
  }
  .prose :global(.exhaust-player__heading) {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.7rem;
  }
  .prose :global(.exhaust-player__heading span) {
    color: #f08a78;
    font-size: 0.625rem;
    font-weight: 650;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .prose :global(.exhaust-player__heading strong) {
    font-size: 0.875rem;
  }
  .prose :global(.exhaust-player iframe) {
    display: block;
    border: 0;
    border-radius: 8px;
    background: #fff;
  }
  .prose :global(.exhaust-player figcaption) {
    margin-top: 0.65rem;
    color: var(--color-muted);
    font-size: 0.7rem;
    line-height: 1.5;
  }
  @media (max-width: 540px) {
    .prose :global(.car-switcher__arrow) {
      width: 2.5rem;
      height: 2.5rem;
    }
    .prose :global(.car-switcher__arrow--previous) { left: 0.45rem; }
    .prose :global(.car-switcher__arrow--next) { right: 0.45rem; }
    .prose :global(.car-switcher__status span) { display: none; }
    .prose :global(.exhaust-player__heading) {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.15rem;
    }
  }
  @media (prefers-color-scheme: light) {
    .prose :global(.car-switcher) {
      --car-edge: rgb(26 23 20 / 0.2);
      --car-glow: rgb(26 23 20 / 0.045);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .prose :global(.car-switcher__car),
    .prose :global(.car-switcher__arrow) {
      transition-duration: 1ms;
    }
  }
  .prose :global(table) {
    display: block;
    width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 0 0 1.75rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .prose :global(th), .prose :global(td) {
    min-width: 9rem;
    padding: 0.7rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }
  .prose :global(th) {
    color: var(--color-text);
    font-weight: 600;
  }
  .prose :global(td) { color: var(--color-muted); }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2.5rem 0;
  }
</style>

<script>
  const initCarSwitchers = () => {
    document.querySelectorAll<HTMLElement>('[data-car-switcher]').forEach((switcher) => {
      if (switcher.dataset.ready === 'true') return;

      const stage = switcher.querySelector<HTMLElement>('[data-car-switcher-stage]');
      const status = switcher.querySelector<HTMLElement>('[data-car-switcher-status]');
      const previous = switcher.querySelector<HTMLButtonElement>('[data-car-switcher-previous]');
      const next = switcher.querySelector<HTMLButtonElement>('[data-car-switcher-next]');
      const cars = Array.from(switcher.querySelectorAll<HTMLElement>('[data-car]'));
      const choices = Array.from(switcher.querySelectorAll<HTMLButtonElement>('[data-car-switcher-select]'));
      if (!stage || !previous || !next || cars.length !== 2) return;

      switcher.dataset.ready = 'true';
      const labels: Record<string, string> = {
        '500c': '2015 FIAT 500c Pop',
        'abarth': '2015 FIAT 500 Abarth',
      };
      let active = switcher.dataset.activeCar === 'abarth' ? 'abarth' : '500c';
      let isSwitching = false;

      const otherCar = () => active === '500c' ? 'abarth' : '500c';

      const updateControls = () => {
        const other = otherCar();
        if (status) status.textContent = labels[active];
        previous.setAttribute('aria-label', `Show ${labels[other]}`);
        next.setAttribute('aria-label', `Show ${labels[other]}`);
        choices.forEach((choice) => {
          choice.setAttribute('aria-pressed', String(choice.dataset.carSwitcherSelect === active));
        });
      };

      const showCar = (target: string, direction: 'next' | 'previous') => {
        if (target === active || isSwitching || !labels[target]) return;

        const outgoing = cars.find((car) => car.dataset.car === active);
        const incoming = cars.find((car) => car.dataset.car === target);
        if (!outgoing || !incoming) return;

        isSwitching = true;
        stage.dataset.direction = direction;
        outgoing.classList.remove('is-active');
        outgoing.classList.add('is-leaving');
        outgoing.setAttribute('aria-hidden', 'true');

        window.setTimeout(() => {
          outgoing.classList.remove('is-leaving');
          switcher.dataset.activeCar = target;
          active = target;
          incoming.classList.add('is-entering');
          incoming.setAttribute('aria-hidden', 'false');
          updateControls();

          requestAnimationFrame(() => {
            requestAnimationFrame(() => {
              incoming.classList.remove('is-entering');
              incoming.classList.add('is-active');
              window.setTimeout(() => { isSwitching = false; }, 360);
            });
          });
        }, 340);
      };

      previous.addEventListener('click', () => showCar(otherCar(), 'previous'));
      next.addEventListener('click', () => showCar(otherCar(), 'next'));
      choices.forEach((choice) => {
        choice.addEventListener('click', () => {
          const target = choice.dataset.carSwitcherSelect;
          if (!target) return;
          showCar(target, target === 'abarth' ? 'next' : 'previous');
        });
      });
      stage.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowLeft') {
          event.preventDefault();
          showCar(otherCar(), 'previous');
        }
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          showCar(otherCar(), 'next');
        }
      });

      updateControls();
    });
  };

  initCarSwitchers();
  document.addEventListener('astro:page-load', initCarSwitchers);
</script>
