---
export const prerender = true;
import type { GetStaticPaths } from 'astro';
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('writing', e => !e.data.draft);
  const tags = [...new Set(posts.flatMap(p => p.data.tags))];
  return tags.map(tag => ({ params: { tag }, props: { tag } }));
};

const { tag } = Astro.props;
const posts = (await getCollection('writing', e => !e.data.draft && e.data.tags.includes(tag)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title={`#${tag} — Writing — Jon Osmond`} description={`Posts tagged "${tag}" on Jon Osmond's site.`}>
  <main class="tag">
    <header class="tag__header">
      <a href="/writing" class="back-link">← All writing</a>
      <p class="eyebrow">Tag</p>
      <h1 class="tag__title">#{tag}</h1>
      <p class="tag__count">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
    </header>

    <ul class="wr__list" role="list">
      {posts.map(post => {
        const d = post.data.date;
        const dateStr = d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
        return (
          <li class="wr__item">
            <a href={`/writing/${post.id}`} class="wr__link">
              <time class="wr__date" datetime={d.toISOString()}>{dateStr}</time>
              <h2 class="wr__post-title">{post.data.title}</h2>
              <p class="wr__desc">{post.data.description}</p>
            </a>
          </li>
        );
      })}
    </ul>
  </main>
</Layout>

<style>
  .tag {
    padding: clamp(4rem, 8vw, 7rem) clamp(2rem, 6vw, 5rem);
    max-width: 720px;
    margin: 0 auto;
  }
  .tag__header { margin-bottom: 4rem; }
  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.8125rem;
    color: var(--color-muted);
    text-decoration: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 6px;
    padding: 0.35rem 0.7rem;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--color-text); }
  .eyebrow {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 0.75rem;
  }
  .tag__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.5rem);
    font-weight: 400;
    line-height: 1.1;
    margin-bottom: 0.4rem;
    color: var(--color-accent);
  }
  .tag__count { font-size: 0.875rem; color: var(--color-muted); }
  /* Reuse writing list styles */
  .wr__list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 2px; }
  .wr__item { border-top: 1px solid var(--color-border); }
  .wr__item:last-child { border-bottom: 1px solid var(--color-border); }
  .wr__link { display: block; padding: 1.5rem 0; text-decoration: none; color: inherit; transition: padding-left 0.2s; }
  .wr__link:hover { padding-left: 0.5rem; }
  .wr__date { display: block; font-size: 0.8rem; color: var(--color-muted); margin-bottom: 0.4rem; font-variant-numeric: tabular-nums; }
  .wr__post-title { font-size: 1.15rem; font-weight: 500; margin-bottom: 0.4rem; line-height: 1.3; }
  .wr__link:hover .wr__post-title { color: var(--color-accent); }
  .wr__desc { font-size: 0.9rem; color: var(--color-muted); line-height: 1.6; }
</style>
