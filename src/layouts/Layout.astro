---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import AIAssistant from '../components/AIAssistant.astro';

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
}

const {
  title = 'Jon Osmond — Interface Developer',
  description = 'I build clean, accessible product interfaces with a focus on simplicity and reliability.',
  ogTitle,
  ogDescription,
  ogImage: ogImageProp,
  ogType = 'website',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://jonosmond.com');
const ogImage = ogImageProp
  ? new URL(ogImageProp, Astro.site ?? 'https://jonosmond.com')
  : new URL('/og.svg', Astro.site ?? 'https://jonosmond.com');
const resolvedOgTitle = ogTitle ?? title;
const resolvedOgDescription = ogDescription ?? description;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- OG -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={resolvedOgTitle} />
    <meta property="og:description" content={resolvedOgDescription} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <ClientRouter />
  </head>
  <body>
    <slot />
    <script>
      // Don't track: analytics page itself, or opted-out visitors
      const isAnalytics = window.location.pathname.startsWith('/analytics');
      const isOptedOut  = localStorage.getItem('analytics_opt_out') === '1';

      function sendEvent(body: object) {
        const blob = new Blob([JSON.stringify(body)], { type: 'application/json' });
        if (navigator.sendBeacon) {
          navigator.sendBeacon('/api/event', blob);
        } else {
          fetch('/api/event', { method: 'POST', body: JSON.stringify(body), headers: { 'Content-Type': 'application/json' }, keepalive: true }).catch(() => {});
        }
      }

      if (!isAnalytics && !isOptedOut) {
        const page = window.location.pathname;
        const w = window.innerWidth;

        // new vs. returning: use localStorage to distinguish first-ever visit
        const HAS_VISITED_KEY = 'analytics_visited';
        const isNew = !localStorage.getItem(HAS_VISITED_KEY);
        localStorage.setItem(HAS_VISITED_KEY, '1');

        // Entry page: no referrer, or referrer is external
        const isEntry = !document.referrer || !document.referrer.includes('jonosmond.com');

        // UTM parameters
        const sp = new URLSearchParams(location.search);
        const utmSource   = sp.get('utm_source')   ?? '';
        const utmMedium   = sp.get('utm_medium')   ?? '';
        const utmCampaign = sp.get('utm_campaign') ?? '';

        const payload = JSON.stringify({
          page,
          referrer: document.referrer,
          colorScheme: window.matchMedia('(prefers-color-scheme: dark)').matches ? 'Dark' : 'Light',
          viewport: w < 768 ? 'Mobile' : w < 1024 ? 'Tablet' : 'Desktop',
          isNew,
          isEntry,
          language: navigator.language ?? '',
          utmSource,
          utmMedium,
          utmCampaign,
        });
        if (typeof navigator.sendBeacon === 'function') {
          navigator.sendBeacon('/api/track', new Blob([payload], { type: 'application/json' }));
        } else {
          fetch('/api/track', {
            method: 'POST',
            body: payload,
            headers: { 'Content-Type': 'application/json' },
            keepalive: true,
          }).catch(() => {});
        }

        // ── Time on page ───────────────────────────────────────────────────
        const pageStartTime = Date.now();
        let durationSent = false;
        function sendDuration() {
          if (durationSent) return;
          durationSent = true;
          const secs = Math.round((Date.now() - pageStartTime) / 1000);
          if (secs < 1) return;
          sendEvent({ type: 'duration', value: String(secs), page });
        }
        // ── Exit page tracking ─────────────────────────────────────────────
        let exitSent = false;
        function sendExit() {
          if (exitSent) return;
          exitSent = true;
          sendEvent({ type: 'exit', page });
        }
        document.addEventListener('visibilitychange', () => {
          if (document.visibilityState === 'hidden') { sendDuration(); sendExit(); }
        });
        window.addEventListener('pagehide', () => { sendDuration(); sendExit(); });

        // ── Scroll depth tracking ──────────────────────────────────────────
        // Fire once per milestone (25 / 50 / 75 / 100) per page view
        const milestones = [25, 50, 75, 100];
        const reached = new Set<number>();
        function checkScroll() {
          const scrolled = window.scrollY + window.innerHeight;
          const total    = document.documentElement.scrollHeight;
          const pct      = total <= window.innerHeight ? 100 : Math.floor((scrolled / total) * 100);
          for (const m of milestones) {
            if (pct >= m && !reached.has(m)) {
              reached.add(m);
              sendEvent({ type: 'scroll', value: String(m), page });
            }
          }
        }
        checkScroll(); // check immediately (catches 100% on short pages)
        window.addEventListener('scroll', checkScroll, { passive: true });

        // ── Outbound click tracking ────────────────────────────────────────
        document.addEventListener('click', (e) => {
          const target = (e.target as Element).closest('a');
          if (!target) return;
          const href = target.getAttribute('href') ?? '';
          // Track mailto: links as "email"
          if (href.startsWith('mailto:')) {
            sendEvent({ type: 'click', value: 'email', page });
            return;
          }
          if (!href.startsWith('http')) return; // internal links & anchors
          try {
            const host = new URL(href).hostname.replace(/^www\./, '');
            if (!host.endsWith('jonosmond.com')) {
              sendEvent({ type: 'click', value: host, page });
            }
          } catch { /* ignore malformed hrefs */ }
        });
      }
    </script>
    <script>
      // ── Core Web Vitals ────────────────────────────────────────────────────
      import { onLCP, onCLS, onINP } from 'web-vitals';
      const _isAnalytics = window.location.pathname.startsWith('/analytics');
      const _isOptedOut  = localStorage.getItem('analytics_opt_out') === '1';
      if (!_isAnalytics && !_isOptedOut) {
        function rateMetric(name: string, value: number): string {
          if (name === 'LCP') return value <= 2500 ? 'good' : value <= 4000 ? 'needs-improvement' : 'poor';
          if (name === 'CLS') return value <= 0.1  ? 'good' : value <= 0.25  ? 'needs-improvement' : 'poor';
          if (name === 'INP') return value <= 200  ? 'good' : value <= 500   ? 'needs-improvement' : 'poor';
          return 'poor';
        }
        function reportVital(m: { name: string; value: number }) {
          const body = JSON.stringify({
            type: 'vitals',
            metric: m.name,
            rating: rateMetric(m.name, m.value),
            page: window.location.pathname,
          });
          navigator.sendBeacon?.('/api/event', new Blob([body], { type: 'application/json' }));
        }
        onLCP(reportVital);
        onCLS(reportVital);
        onINP(reportVital);
      }
    </script>
    <script>
      // ── Copy code buttons ──────────────────────────────────────────────────
      function attachCopyButtons() {
        document.querySelectorAll('pre:not([data-copy-attached])').forEach(pre => {
          pre.setAttribute('data-copy-attached', '');
          const btn = document.createElement('button');
          btn.className = 'copy-btn';
          btn.setAttribute('aria-label', 'Copy code');
          btn.innerHTML = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5" y="5" width="8" height="8" rx="1.5"/><path d="M3 11V3h8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
          btn.addEventListener('click', async () => {
            const code = pre.querySelector('code')?.innerText ?? pre.innerText;
            try {
              await navigator.clipboard.writeText(code);
              btn.classList.add('copy-btn--done');
              btn.innerHTML = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 8l3.5 3.5L13 5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
              setTimeout(() => {
                btn.classList.remove('copy-btn--done');
                btn.innerHTML = `<svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><rect x="5" y="5" width="8" height="8" rx="1.5"/><path d="M3 11V3h8" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
              }, 2000);
            } catch { /* clipboard denied */ }
          });
          (pre as HTMLElement).style.position = 'relative';
          pre.appendChild(btn);
        });
      }
      attachCopyButtons();
      document.addEventListener('astro:page-load', attachCopyButtons);
    </script>
    <script>
      // ── Keyboard shortcuts ─────────────────────────────────────────────────
      // G then H = home, G then W = writing, G then L = lab
      let gPressed = false;
      let gTimer: ReturnType<typeof setTimeout>;
      document.addEventListener('keydown', (e) => {
        const tag = (e.target as Element).tagName;
        if (tag === 'INPUT' || tag === 'TEXTAREA' || (e.target as HTMLElement).isContentEditable) return;
        if (e.metaKey || e.ctrlKey || e.altKey) return;
        if (e.key === 'g' || e.key === 'G') {
          gPressed = true;
          clearTimeout(gTimer);
          gTimer = setTimeout(() => { gPressed = false; }, 1500);
          return;
        }
        if (gPressed) {
          gPressed = false;
          clearTimeout(gTimer);
          const nav: Record<string, string> = { h: '/', H: '/', w: '/writing', W: '/writing', l: '/lab', L: '/lab', u: '/uses', U: '/uses' };
          const dest = nav[e.key];
          if (dest) { e.preventDefault(); window.location.href = dest; }
        }
      });
    </script>
    <AIAssistant />
  </body>
</html>
